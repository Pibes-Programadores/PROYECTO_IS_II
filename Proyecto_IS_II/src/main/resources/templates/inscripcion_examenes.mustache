<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Inscripción a Exámenes Finales</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-4xl bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 mx-auto">
        <h1 class="text-3xl font-bold text-center text-[#1a3a5c] dark:text-white mb-2">Mesas de Examen Disponibles</h1>
        <p class="text-center text-gray-500 dark:text-gray-400 text-sm mb-6">Aquí aparecen únicamente las materias en condición REGULAR o LIBRE con sus correlatividades de examen aprobadas.</p>

        <div id="alertas" class="mb-4"></div>

        <div class="overflow-x-auto rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
            <table class="w-full text-left border-collapse text-gray-700 dark:text-gray-300 bg-white dark:bg-[#2a3a4d]">
                <thead class="bg-[#1a3a5c] text-white dark:bg-[#112133]">
                    <tr>
                        <th class="py-3 px-4 font-semibold text-sm uppercase tracking-wider">Código de Materia</th>
                        <th class="py-3 px-4 font-semibold text-sm uppercase tracking-wider">Fecha del Llamado</th>
                        <th class="py-3 px-4 font-semibold text-sm uppercase tracking-wider text-center">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    {{#mesas}}
                    <tr class="hover:bg-gray-50 dark:hover:bg-[#1f3044] transition-colors">
                        <td class="py-4 px-4 font-medium text-lg text-[#2471a3] dark:text-[#eaf2ff]">{{materia_codigo}}</td>
                        <td class="py-4 px-4 text-gray-600 dark:text-gray-300">{{fecha}}</td>
                        <td class="py-4 px-4 text-center">
                            <form action="/estudiante/inscripcion/examen" method="POST" class="m-0">
                                <input type="hidden" name="mesa_id" value="{{id}}">
                                <button type="submit" class="bg-[#2471a3] hover:bg-[#1a5276] text-white font-medium py-1.5 px-4 rounded transition-colors text-sm shadow focus:outline-none focus:ring-2 focus:ring-[#2471a3] focus:ring-offset-2">
                                    Inscribirse
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/mesas}}
                    {{^mesas}}
                    <tr>
                        <td colspan="3" class="text-center text-gray-500 dark:text-gray-400 py-8 text-sm italic">
                            No tenés mesas de examen disponibles que cumplan con tus requisitos académicos actuales.
                        </td>
                    </tr>
                    {{/mesas}}
                </tbody>
            </table>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700 flex justify-center">
            <a href="/dashboard" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline transition-colors text-sm flex items-center gap-2">
                ← Volver al panel principal
            </a>
        </div>
    </div>

    <script>
        // Script simple para leer las alertas que manda el backend en la URL (?success=... o ?error=...)
        const urlParams = new URLSearchParams(window.location.search);
        const alertasDiv = document.getElementById('alertas');
        if(urlParams.has('success')) {
            alertasDiv.innerHTML = `<div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded text-sm mb-4">${urlParams.get('success')}</div>`;
        } else if(urlParams.has('error')) {
            alertasDiv.innerHTML = `<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded text-sm mb-4">${urlParams.get('error')}</div>`;
        }
    </script>
    {{> _layout_footer}}
</body>
</html>
