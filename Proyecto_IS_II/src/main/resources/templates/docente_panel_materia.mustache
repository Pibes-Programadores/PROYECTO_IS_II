<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Panel - {{nombreMateria}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] min-h-screen p-6 flex flex-col items-center">
    <div class="w-full max-w-4xl space-y-8">

        <!-- Encabezado -->
        <div class="bg-[#190019]/60 border border-purple-700/40 rounded-lg p-6">
            <p class="text-purple-400 text-sm font-mono uppercase tracking-widest mb-1">Código {{codigoMateria}}</p>
            <h1 class="text-3xl font-bold text-white">{{nombreMateria}}</h1>
            <p class="text-[#ccd0fc] text-sm mt-1">Año de cursada: {{anioMateria}}° — {{periodoMateria}}</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <!-- SECCIÓN 1: Anuncios -->
        <div class="bg-[#190019]/60 border border-yellow-700/40 rounded-lg p-6 shadow-lg">
            <h2 class="text-2xl font-bold text-yellow-400 mb-4">📢 Publicar Anuncio</h2>
            <form action="/docente/materia/{{codigoMateria}}/anuncio" method="post" class="space-y-4">
                <div>
                    <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Tipo de Anuncio:</label>
                    <select name="tipo" id="tipoAnuncio" onchange="toggleFechaExamen(this)"
                            class="w-full px-4 py-2 border rounded-md bg-white text-gray-900 focus:ring-2 focus:ring-yellow-500">
                        <option value="GENERAL">General</option>
                        <option value="EXAMEN">Examen / Fecha de Evaluación</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Título:</label>
                    <input type="text" name="titulo" required
                           class="w-full px-4 py-2 border rounded-md text-gray-900 focus:ring-2 focus:ring-yellow-500"
                           placeholder="Ej: Parcial 1 — Unidades 1 a 3">
                </div>
                <div>
                    <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Contenido:</label>
                    <textarea name="contenido" rows="3" required
                              class="w-full px-4 py-2 border rounded-md text-gray-900 focus:ring-2 focus:ring-yellow-500"
                              placeholder="Detalle del anuncio..."></textarea>
                </div>
                <div id="fechaExamenContainer" class="hidden">
                    <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Fecha del Examen:</label>
                    <input type="date" name="fecha_examen"
                           class="w-full px-4 py-2 border rounded-md text-gray-900 focus:ring-2 focus:ring-yellow-500">
                </div>
                <button type="submit"
                        class="w-full bg-yellow-500 text-white py-2 px-4 rounded-md hover:bg-yellow-600 transition duration-300 font-medium">
                    Publicar Anuncio
                </button>
            </form>
        </div>

        <!-- SECCIÓN 2: Cargar Notas -->
        <div class="bg-[#190019]/60 border border-green-700/40 rounded-lg p-6 shadow-lg">
            <h2 class="text-2xl font-bold text-green-400 mb-4">📝 Cargar Nota</h2>
            {{#hayAlumnos}}
            <form action="/docente/materia/{{codigoMateria}}/nota" method="post" class="space-y-4">
                <div>
                    <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Alumno:</label>
                    <select name="student_id" required
                            class="w-full px-4 py-2 border rounded-md bg-white text-gray-900 focus:ring-2 focus:ring-green-500">
                        <option value="">— Seleccioná un alumno —</option>
                        {{#alumnos}}
                        <option value="{{id}}">{{label}}</option>
                        {{/alumnos}}
                    </select>
                </div>
                            <div>
                <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Nota (0.00 — 10.00):</label>
                <input type="number" name="valor" min="0" max="10" step="0.01" required
                       class="w-full px-4 py-2 border rounded-md text-gray-900 focus:ring-2 focus:ring-green-500"
                       placeholder="Ej: 7.50">
            </div>
            <div>
                <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Estado de Cursada:</label>
                <select name="estado_cursada" required
                        class="w-full px-4 py-2 border rounded-md bg-white text-gray-900 focus:ring-2 focus:ring-green-500">
                    <option value="REGULAR">Regular</option>
                    <option value="LIBRE">Libre</option>
                    <option value="PROMOCION">Promoción (exime de final)</option>
                </select>
            </div>
            <button type="submit"
                        class="w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition duration-300 font-medium">
                    Registrar Nota
                </button>
            </form>
            {{/hayAlumnos}}
            {{^hayAlumnos}}
            <p class="text-[#ccd0fc] text-sm bg-[#190019]/80 p-4 rounded-md border border-purple-500/30">
                Actualmente no hay alumnos inscriptos en esta comisión.
            </p>
            {{/hayAlumnos}}
        </div>
                <!-- SECCIÓN ANUNCIOS PUBLICADOS -->
        {{#anuncios}}
        <div class="bg-[#190019]/60 border border-yellow-700/20 rounded-lg p-6 shadow-lg">
            <h2 class="text-xl font-bold text-yellow-300 mb-4">📋 Anuncios Publicados</h2>
            <div class="space-y-3">
                {{#anuncios}}
                <div class="bg-white/10 rounded-md p-4">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="text-xs font-mono uppercase text-yellow-400">{{tipo}}</span>
                            <p class="text-white font-semibold">{{titulo}}</p>
                            <p class="text-[#ccd0fc] text-sm">{{contenido}}</p>
                            {{#fechaExamen}}<p class="text-yellow-300 text-xs mt-1">📅 Fecha: {{fechaExamen}}</p>{{/fechaExamen}}
                        </div>
                        {{#esExamen}}
                        <div class="text-right ml-4">
                            <span class="inline-block bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full">
                                {{inscriptosCount}} inscripto(s)
                            </span>
                        </div>
                        {{/esExamen}}
                    </div>
                </div>
                {{/anuncios}}
            </div>
        </div>
        {{/anuncios}}
        <!-- SECCIÓN 3: Asignar Aula -->
        <div class="bg-[#190019]/60 border border-blue-700/40 rounded-lg p-6 shadow-lg">
            <h2 class="text-2xl font-bold text-blue-400 mb-4">🏫 Asignar Aula</h2>
            <form action="/docente/materia/{{codigoMateria}}/aula" method="post" class="space-y-4">
                <div>
                    <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Número / Nombre del Aula:</label>
                    <input type="text" name="aula" required
                           class="w-full px-4 py-2 border rounded-md text-gray-900 focus:ring-2 focus:ring-blue-500"
                           placeholder="Ej: Aula 12 — Edificio A">
                </div>
                <button type="submit"
                        class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300 font-medium">
                    Confirmar Asignación
                </button>
            </form>
        </div>

        <!-- SECCIÓN 4: Subir Contenido -->
        <div class="bg-[#190019]/60 border border-pink-700/40 rounded-lg p-6 shadow-lg">
            <h2 class="text-2xl font-bold text-pink-400 mb-2">📁 Subir Contenido</h2>
            <p class="text-[#ccd0fc] text-sm mb-4">Subí apuntes, presentaciones y materiales de estudio para tus alumnos.</p>
            <a href="/docente/materia/{{codigoMateria}}/contenido"
               class="inline-block bg-pink-600 text-white py-2 px-6 rounded-md hover:bg-pink-700 transition duration-300 font-medium">
                Ir a Subir Contenido →
            </a>
        </div>

                <!-- Navegación -->
        <div class="text-center pb-6 space-y-2">
            <div>
                <a href="/docente/notas-finales" class="inline-block bg-indigo-600 text-white py-2 px-6 rounded-md hover:bg-indigo-700 transition duration-300 font-medium text-sm">
                    📋 Ir a Carga de Actas de Finales
                </a>
            </div>
            <div>
                <a href="/docente/materias" class="text-purple-300 hover:underline text-sm">← Volver a Mis Materias</a>
            </div>
        </div>
    </div>

    <script>
        function toggleFechaExamen(select) {
            const container = document.getElementById('fechaExamenContainer');
            if (select.value === 'EXAMEN') {
                container.classList.remove('hidden');
                container.querySelector('input').setAttribute('required', 'required');
            } else {
                container.classList.add('hidden');
                container.querySelector('input').removeAttribute('required');
            }
        }
    </script>
</body>
</html>