<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Panel - {{nombreMateria}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-4xl mx-auto space-y-8 p-4 md:p-8">

        <!-- Encabezado -->
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <p class="text-gray-500 dark:text-gray-400 text-sm font-mono uppercase tracking-widest mb-1">Código {{codigoMateria}}</p>
            <h1 class="text-3xl font-bold text-[#1a3a5c] dark:text-white">{{nombreMateria}}</h1>
            <p class="text-gray-600 dark:text-gray-300 text-sm mt-1">Año de cursada: {{anioMateria}}° — {{periodoMateria}}</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <!-- SECCIÓN 1: Anuncios -->
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <h2 class="text-2xl font-bold text-[#1a3a5c] dark:text-white mb-4 border-b border-[#2471a3] dark:border-blue-400 pb-2">📢 Publicar Anuncio</h2>
            <form action="/docente/materia/{{codigoMateria}}/anuncio" method="post" class="space-y-4">
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Tipo de Anuncio:</label>
                    <select name="tipo" id="tipoAnuncio" onchange="toggleFechaExamen(this)"
                            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                        <option value="GENERAL">General</option>
                        <option value="EXAMEN">Examen / Fecha de Evaluación</option>
                    </select>
                </div>
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Título:</label>
                    <input type="text" name="titulo" required
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]"
                           placeholder="Ej: Parcial 1 — Unidades 1 a 3">
                </div>
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Contenido:</label>
                    <textarea name="contenido" rows="3" required
                              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]"
                              placeholder="Detalle del anuncio..."></textarea>
                </div>
                <div id="fechaExamenContainer" class="hidden">
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Fecha del Examen:</label>
                    <input type="date" name="fecha_examen"
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                </div>
                <button type="submit"
                        class="w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors duration-300 font-medium focus:outline-none focus:ring-2 focus:ring-[#2471a3] focus:ring-offset-2">
                    Publicar Anuncio
                </button>
            </form>
        </div>

        <!-- SECCIÓN 2: Cargar Notas -->
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <h2 class="text-2xl font-bold text-[#1a3a5c] dark:text-white mb-4 border-b border-green-500 dark:border-green-400 pb-2 flex items-center gap-2"><span>📝 </span> Cargar Nota</h2>
            {{#hayAlumnos}}
            <form action="/docente/materia/{{codigoMateria}}/nota" method="post" class="space-y-4">
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Alumno:</label>
                    <select name="student_id" required
                            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-600">
                        <option value="">— Seleccioná un alumno —</option>
                        {{#alumnos}}
                        <option value="{{id}}">{{label}}</option>
                        {{/alumnos}}
                    </select>
                </div>
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nota (0.00 — 10.00):</label>
                    <input type="number" name="valor" min="0" max="10" step="0.01" required
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-600"
                           placeholder="Ej: 7.50">
                </div>
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Estado de Cursada:</label>
                    <select name="estado_cursada" required
                            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-600">
                        <option value="REGULAR">Regular</option>
                        <option value="LIBRE">Libre</option>
                        <option value="PROMOCION">Promoción (exime de final)</option>
                    </select>
                </div>
                <button type="submit"
                        class="w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition-colors duration-300 font-medium focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2">
                    Registrar Nota
                </button>
            </form>
            {{/hayAlumnos}}
            {{^hayAlumnos}}
            <p class="text-gray-600 dark:text-gray-400 text-sm bg-gray-50 dark:bg-[#1a2b3c] p-4 rounded-md border border-gray-200 dark:border-gray-600 italic">
                Actualmente no hay alumnos inscriptos en esta comisión.
            </p>
            {{/hayAlumnos}}
        </div>

        <!-- SECCIÓN ANUNCIOS PUBLICADOS -->
        {{#anuncios}}
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white mb-4 border-b border-yellow-500 dark:border-yellow-400 pb-2 flex items-center gap-2"><span>📋</span> Anuncios Publicados</h2>
            <div class="space-y-3">
                {{#anuncios}}
                <div class="bg-gray-50 dark:bg-[#1a2b3c] border border-gray-200 dark:border-gray-600 rounded-md p-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start">
                        <div>
                            <span class="text-xs font-mono uppercase font-bold tracking-wider {{#esExamen}}text-red-600 dark:text-red-400{{/esExamen}}{{^esExamen}}text-blue-600 dark:text-blue-400{{/esExamen}}">{{tipo}}</span>
                            <p class="text-gray-900 dark:text-white font-semibold mt-1">{{titulo}}</p>
                            <p class="text-gray-700 dark:text-gray-300 text-sm mt-1">{{contenido}}</p>
                            {{#fechaExamen}}<p class="text-red-600 dark:text-red-400 font-medium text-xs mt-2 flex items-center gap-1"><span>📅</span> Fecha: {{fechaExamen}}</p>{{/fechaExamen}}
                        </div>
                        {{#esExamen}}
                        <div class="mt-3 sm:mt-0 sm:ml-4 text-right">
                            <span class="inline-block bg-[#2471a3] text-white text-xs font-bold px-3 py-1 rounded-full">
                                {{inscriptosCount}} inscripto(s)
                            </span>
                        </div>
                        {{/esExamen}}
                    </div>
                </div>
                {{/anuncios}}
            </div>
        </div>
        {{/anuncios}}

        <!-- SECCIÓN 3: Asignar Aula -->
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <h2 class="text-2xl font-bold text-[#1a3a5c] dark:text-white mb-4 border-b border-indigo-500 dark:border-indigo-400 pb-2 flex items-center gap-2"><span>🏫</span> Asignar Aula</h2>
            <form action="/docente/materia/{{codigoMateria}}/aula" method="post" class="space-y-4">
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Número / Nombre del Aula:</label>
                    <input type="text" name="aula" required
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-600"
                           placeholder="Ej: Aula 12 — Edificio A">
                </div>
                <button type="submit"
                        class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 transition-colors duration-300 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                    Confirmar Asignación
                </button>
            </form>
        </div>

        <!-- SECCIÓN 4: Subir Contenido -->
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <h2 class="text-2xl font-bold text-[#1a3a5c] dark:text-white mb-2 border-b border-pink-500 dark:border-pink-400 pb-2 flex items-center gap-2"><span>📝</span> Subir Contenido</h2>
            <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">Subí apuntes, presentaciones y materiales de estudio para tus alumnos.</p>
            <a href="/docente/materia/{{codigoMateria}}/contenido"
               class="inline-block bg-pink-600 text-white py-2 px-6 rounded-md hover:bg-pink-700 transition-colors duration-300 font-medium focus:outline-none focus:ring-2 focus:ring-pink-600 focus:ring-offset-2">
                Ir a Subir Contenido →
            </a>
        </div>

        <!-- Navegación -->
        <div class="text-center pb-6 space-y-4 mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
            <div>
                <a href="/docente/notas-finales" class="inline-block bg-white dark:bg-[#1e2a3a] border border-gray-300 dark:border-gray-600 text-[#1a3a5c] dark:text-white py-2 px-6 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-300 font-medium text-sm shadow-sm">
                    📋 Ir a Carga de Actas de Finales
                </a>
            </div>
            <div>
                <a href="/docente/materias" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline transition-colors text-sm">← Volver a Mis Materias</a>
            </div>
        </div>
    </div>

    <script>
        function toggleFechaExamen(select) {
            const container = document.getElementById('fechaExamenContainer');
            if (select.value === 'EXAMEN') {
                container.classList.remove('hidden');
                container.querySelector('input').setAttribute('required', 'required');
            } else {
                container.classList.add('hidden');
                container.querySelector('input').removeAttribute('required');
            }
        }
    </script>
    {{> _layout_footer}}
</body>
</html>
