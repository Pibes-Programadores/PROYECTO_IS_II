<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mis Materias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] min-h-screen p-6 flex flex-col items-center">
    <div class="w-full max-w-5xl bg-gradient-to-b from-[#190019] to-[#dfb6b2] p-8 rounded-lg shadow-xl border border-purple-900/30">
        <h1 class="text-3xl font-bold text-center text-white mb-2">Mis Materias Asignadas</h1>
        <p class="text-center text-[#ccd0fc] mb-8">Seleccioná una materia para gestionar su contenido.</p>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#sinMaterias}}
        <div class="bg-amber-900/30 border border-amber-600/50 text-amber-200 p-6 rounded-md text-center">
            ⚠️ No tenés materias asignadas aún. Contactá a la Secretaría Académica.
        </div>
        {{/sinMaterias}}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {{#materias}}
            <div class="bg-[#190019]/60 border border-purple-700/40 rounded-lg p-6 flex flex-col justify-between shadow-lg hover:border-purple-500 transition duration-200">
                <div>
                    <span class="text-xs font-mono text-purple-400 uppercase tracking-widest">Código {{codigo}}</span>
                    <h2 class="text-xl font-bold text-white mt-1 mb-3">{{nombre}}</h2>
                    <p class="text-[#ccd0fc] text-sm">Año de cursada: <span class="font-semibold">{{anio_cursada}}°</span></p>
                </div>
                <a href="/docente/materia/{{codigo}}"
                   class="mt-5 inline-block text-center bg-purple-600 text-white py-2 px-4 rounded-md hover:bg-purple-700 transition duration-300 font-medium">
                    Ingresar →
                </a>
            </div>
            {{/materias}}
        </div>

        <div class="text-center mt-8">
            <a href="/dashboard" class="text-purple-300 hover:underline text-sm">← Volver al Dashboard</a>
        </div>
    </div>
</body>
</html>
