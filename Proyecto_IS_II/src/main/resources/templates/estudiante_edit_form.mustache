<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SiGU - Editar Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full min-h-screen flex items-center justify-center p-4">

        <div class="w-full max-w-2xl bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">

            <h1 class="text-3xl font-bold text-center text-[#1a3a5c] dark:text-white mb-2">Editar Estudiante</h1>
            <p class="text-center text-gray-500 dark:text-gray-400 text-sm mb-6">
                Modificá los datos del estudiante. Los campos marcados con * son obligatorios.
            </p>

            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
                <span class="block sm:inline">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <!-- Datos de solo lectura -->
            <div class="bg-gray-50 dark:bg-[#1a2b3c] border border-gray-200 dark:border-gray-600 rounded-lg p-4 mb-6">
                <p class="text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider mb-2 font-semibold">Identificadores del sistema (no editables)</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                    <div>
                        <span class="text-gray-500 dark:text-gray-400">Usuario: </span>
                        <span class="text-gray-900 dark:text-white font-mono">{{nombre_usuario}}</span>
                    </div>
                    <div>
                        <span class="text-gray-500 dark:text-gray-400">Legajo: </span>
                        <span class="text-gray-900 dark:text-white font-mono">{{legajo}}</span>
                    </div>
                </div>
            </div>

            <form action="/estudiante/edit/{{id}}" method="post" class="space-y-4">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nombre *</label>
                        <input type="text" name="nombre" value="{{nombre}}" required
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                    </div>
                    <div>
                        <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Apellido *</label>
                        <input type="text" name="apellido" value="{{apellido}}" required
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                    </div>
                </div>

                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">DNI</label>
                    <input type="text" name="dni" value="{{dni}}"
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                </div>

                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Dirección</label>
                    <input type="text" name="direccion" value="{{direccion}}"
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                </div>

                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Teléfono</label>
                    <input type="text" name="telefono" value="{{telefono}}"
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                </div>

                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Tipo de estudiante *</label>
                    <select name="tipo_estudiante" required
                            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                        <option value="REGULAR"     {{#esRegular}}selected{{/esRegular}}>Regular</option>
                        <option value="VOCACIONAL"  {{#esVocacional}}selected{{/esVocacional}}>Vocacional</option>
                        <option value="INTERCAMBIO" {{#esIntercambio}}selected{{/esIntercambio}}>Intercambio</option>
                    </select>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 pt-4">
                    <button type="submit"
                            class="flex-1 bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors duration-300 font-semibold focus:outline-none focus:ring-2 focus:ring-[#2471a3] focus:ring-offset-2">
                        Guardar cambios
                    </button>
                    <a href="/configuracion#estudiantes"
                       class="flex-1 text-center bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 py-2 px-4 rounded-md hover:bg-gray-200 dark:hover:bg-gray-600 border border-gray-300 dark:border-gray-600 transition-colors duration-300 font-semibold">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
    {{> _layout_footer}}
</body>
</html>
