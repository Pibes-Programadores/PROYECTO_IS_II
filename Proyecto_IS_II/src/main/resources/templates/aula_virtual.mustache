<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Aula Virtual</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] min-h-screen p-6 flex flex-col items-center">
    <div class="w-full max-w-4xl space-y-6">
        <div class="bg-[#190019]/60 border border-yellow-700/40 rounded-lg p-6">
            <h1 class="text-3xl font-bold text-yellow-400">📚 Aula Virtual</h1>
            <p class="text-[#ccd0fc] text-sm mt-1">Anuncios de tus materias cursando</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">{{successMessage}}</div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">{{errorMessage}}</div>
        {{/errorMessage}}

        {{#materias}}
        <div class="bg-[#190019]/60 border border-purple-700/40 rounded-lg p-6 shadow-lg">
            <h2 class="text-xl font-bold text-white mb-1">{{nombre}}</h2>
            <p class="text-[#ccd0fc] text-xs font-mono mb-4">Código {{codigo}}</p>

            {{#anuncios}}
            <div class="bg-white/10 rounded-md p-4 mb-3">
                <div class="flex justify-between items-start gap-4">
                    <div class="flex-1">
                        <span class="text-xs font-mono uppercase {{#esExamen}}text-yellow-400{{/esExamen}}{{^esExamen}}text-blue-400{{/esExamen}}">
                            {{tipo}}
                        </span>
                        <p class="text-white font-semibold">{{titulo}}</p>
                        <p class="text-[#ccd0fc] text-sm">{{contenido}}</p>
                        {{#fechaExamen}}<p class="text-yellow-300 text-xs mt-1">📅 {{fechaExamen}}</p>{{/fechaExamen}}
                    </div>
                    {{#esExamen}}
                    <div class="flex-shrink-0">
                        {{#yaInscripto}}
                        <span class="inline-block bg-green-700 text-green-100 text-xs font-bold px-3 py-2 rounded-md">
                            ✓ Asistencia confirmada
                        </span>
                        {{/yaInscripto}}
                        {{^yaInscripto}}
                        <form action="/estudiante/inscripcion-parcial" method="post" class="m-0">
                            <input type="hidden" name="anuncio_id" value="{{id}}">
                            <button type="submit"
                                    class="bg-yellow-500 hover:bg-yellow-600 text-white text-xs font-bold px-3 py-2 rounded-md transition-colors">
                                Confirmar asistencia
                            </button>
                        </form>
                        {{/yaInscripto}}
                    </div>
                    {{/esExamen}}
                </div>
            </div>
            {{/anuncios}}

            {{^anuncios}}
            <p class="text-[#ccd0fc]/50 text-sm italic">No hay anuncios publicados para esta materia.</p>
            {{/anuncios}}
        </div>
        {{/materias}}

        {{^materias}}
        <div class="bg-[#190019]/60 border border-white/10 rounded-lg p-12 text-center">
            <p class="text-[#ccd0fc]/60 text-sm italic">No tenés materias en curso actualmente.</p>
        </div>
        {{/materias}}

        <div class="text-center pb-6">
            <a href="/dashboard" class="text-[#ccd0fc] hover:text-white text-sm">← Volver al Dashboard</a>
        </div>
    </div>
</body>
</html>