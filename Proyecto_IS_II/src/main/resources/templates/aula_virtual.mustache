<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Aula Virtual</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-4xl mx-auto space-y-6 p-4 md:p-8">
        <div class="bg-[#1a3a5c] dark:bg-[#112133] border border-[#2471a3] rounded-lg p-6 shadow-sm">
            <h1 class="text-3xl font-bold text-white">📚 Aula Virtual</h1>
            <p class="text-[#eaf2ff] text-sm mt-1">Anuncios de tus materias cursando</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">{{successMessage}}</div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">{{errorMessage}}</div>
        {{/errorMessage}}

        {{#materias}}
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white mb-1">{{nombre}}</h2>
            <p class="text-gray-500 dark:text-gray-400 text-xs font-mono mb-4">Código {{codigo}}</p>

            {{#anuncios}}
            <div class="bg-gray-50 dark:bg-[#1a2b3c] border border-gray-200 dark:border-gray-600 rounded-md p-4 mb-3 shadow-sm">
                <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
                    <div class="flex-1">
                        <span class="text-xs font-mono uppercase font-bold tracking-wider {{#esExamen}}text-red-600 dark:text-red-400{{/esExamen}}{{^esExamen}}text-blue-600 dark:text-blue-400{{/esExamen}}">
                            {{tipo}}
                        </span>
                        <p class="text-gray-900 dark:text-white font-semibold mt-1">{{titulo}}</p>
                        <p class="text-gray-700 dark:text-gray-300 text-sm mt-1">{{contenido}}</p>
                        {{#fechaExamen}}<p class="text-red-600 dark:text-red-400 font-medium text-xs mt-2 flex items-center gap-1"><span>📅</span> {{fechaExamen}}</p>{{/fechaExamen}}
                    </div>
                    {{#esExamen}}
                    <div class="flex-shrink-0 mt-3 sm:mt-0 w-full sm:w-auto">
                        {{#yaInscripto}}
                        <span class="block text-center bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800 text-xs font-bold px-3 py-2 rounded-md">
                            ✓ Asistencia confirmada
                        </span>
                        {{/yaInscripto}}
                        {{^yaInscripto}}
                        <form action="/estudiante/inscripcion-parcial" method="post" class="m-0 w-full">
                            <input type="hidden" name="anuncio_id" value="{{id}}">
                            <button type="submit"
                                    class="w-full bg-yellow-500 hover:bg-yellow-600 text-white text-xs font-bold px-4 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2">
                                Confirmar asistencia
                            </button>
                        </form>
                        {{/yaInscripto}}
                    </div>
                    {{/esExamen}}
                </div>
            </div>
            {{/anuncios}}

            {{^anuncios}}
            <p class="text-gray-500 dark:text-gray-400 text-sm italic py-2">No hay anuncios publicados para esta materia.</p>
            {{/anuncios}}
        </div>
        {{/materias}}

        {{^materias}}
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-12 text-center shadow-sm">
            <p class="text-gray-500 dark:text-gray-400 text-sm italic">No tenés materias en curso actualmente.</p>
        </div>
        {{/materias}}

        <div class="text-center pb-6 mt-4">
            <a href="/dashboard" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline transition-colors text-sm">← Volver al Dashboard</a>
        </div>
    </div>
    {{> _layout_footer}}
</body>
</html>
