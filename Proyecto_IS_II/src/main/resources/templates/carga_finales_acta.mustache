<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Acta de Final — {{nombreMateria}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] min-h-screen p-6 flex flex-col items-center">
    <div class="w-full max-w-4xl space-y-6">
        <div class="bg-[#190019]/60 border border-indigo-700/40 rounded-lg p-6">
            <p class="text-indigo-400 text-xs font-mono uppercase tracking-widest mb-1">Acta de Final — {{fecha}}</p>
            <h1 class="text-3xl font-bold text-white">{{nombreMateria}}</h1>
            <p class="text-[#ccd0fc] text-sm mt-1">Solo se muestran los alumnos inscriptos a esta mesa</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">{{successMessage}}</div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">{{errorMessage}}</div>
        {{/errorMessage}}

        {{#inscriptos}}
        <div class="bg-[#190019]/60 border border-indigo-700/20 rounded-lg overflow-hidden">
            <table class="w-full text-left text-white">
                <thead>
                    <tr class="border-b border-indigo-700/30 text-[#ccd0fc]">
                        <th class="py-3 px-4 text-sm font-semibold">Alumno</th>
                        <th class="py-3 px-4 text-sm font-semibold">Legajo</th>
                        <th class="py-3 px-4 text-sm font-semibold text-center">Nota (0-10)</th>
                        <th class="py-3 px-4 text-sm font-semibold text-center">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-indigo-700/20">
                    {{#inscriptos}}
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="py-4 px-4 font-medium">{{nombre}}</td>
                        <td class="py-4 px-4 text-gray-300 font-mono text-sm">{{legajo}}</td>
                        <td class="py-4 px-4 text-center">
                            <form action="/docente/notas-finales/{{mesaId}}" method="post" class="flex items-center justify-center gap-2">
                                <input type="hidden" name="student_id" value="{{usuarioId}}">
                                <input type="number" name="valor" min="0" max="10" step="0.01" required
                                       class="w-24 px-2 py-1 border rounded text-gray-900 text-sm focus:ring-2 focus:ring-indigo-500"
                                       placeholder="0.00">
                                <button type="submit"
                                        class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3 py-1.5 rounded transition-colors">
                                    Registrar
                                </button>
                            </form>
                        </td>
                        <td></td>
                    </tr>
                    {{/inscriptos}}
                </tbody>
            </table>
        </div>
        {{/inscriptos}}

        {{^inscriptos}}
        <div class="bg-[#190019]/60 border border-white/10 rounded-lg p-12 text-center">
            <p class="text-[#ccd0fc]/60 text-sm italic">No hay alumnos inscriptos a esta mesa de examen.</p>
        </div>
        {{/inscriptos}}

        <div class="text-center pb-6">
            <a href="/docente/notas-finales" class="text-indigo-300 hover:underline text-sm">← Volver a Mesas de Examen</a>
        </div>
    </div>
</body>
</html>