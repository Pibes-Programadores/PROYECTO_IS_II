<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Acta de Final — {{nombreMateria}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-4xl mx-auto space-y-6 p-4 md:p-8">
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
            <p class="text-gray-500 dark:text-gray-400 text-xs font-mono uppercase tracking-widest mb-1">Acta de Final — {{fecha}}</p>
            <h1 class="text-3xl font-bold text-[#1a3a5c] dark:text-white">{{nombreMateria}}</h1>
            <p class="text-gray-600 dark:text-gray-300 text-sm mt-1">Solo se muestran los alumnos inscriptos a esta mesa</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-sm">{{successMessage}}</div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-sm">{{errorMessage}}</div>
        {{/errorMessage}}

        {{#inscriptos}}
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden">
            <table class="w-full text-left text-gray-800 dark:text-gray-200">
                <thead>
                    <tr class="bg-[#1a3a5c] dark:bg-[#112133] text-white border-b border-[#2471a3]">
                        <th class="py-3 px-4 text-sm font-semibold uppercase tracking-wider">Alumno</th>
                        <th class="py-3 px-4 text-sm font-semibold uppercase tracking-wider">Legajo</th>
                        <th class="py-3 px-4 text-sm font-semibold uppercase tracking-wider text-center">Nota (0-10)</th>
                        <th class="py-3 px-4 text-sm font-semibold uppercase tracking-wider text-center">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    {{#inscriptos}}
                    <tr class="hover:bg-gray-50 dark:hover:bg-[#1f3044] transition-colors">
                        <td class="py-4 px-4 font-medium">{{nombre}}</td>
                        <td class="py-4 px-4 text-gray-500 dark:text-gray-400 font-mono text-sm">{{legajo}}</td>
                        <td class="py-4 px-4 text-center">
                            <form action="/docente/notas-finales/{{mesaId}}" method="post" class="flex items-center justify-center gap-2 m-0">
                                <input type="hidden" name="student_id" value="{{usuarioId}}">
                                <input type="number" name="valor" min="0" max="10" step="0.01" required
                                       class="w-24 px-2 py-1 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-[#2471a3]"
                                       placeholder="0.00">
                                <button type="submit"
                                        class="bg-[#2471a3] hover:bg-[#1a5276] text-white text-xs font-bold px-3 py-1.5 rounded transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-[#2471a3] focus:ring-offset-2">
                                    Registrar
                                </button>
                            </form>
                        </td>
                        <td></td>
                    </tr>
                    {{/inscriptos}}
                </tbody>
            </table>
        </div>
        {{/inscriptos}}

        {{^inscriptos}}
        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg p-12 text-center shadow-sm">
            <p class="text-gray-500 dark:text-gray-400 text-sm italic">No hay alumnos inscriptos a esta mesa de examen.</p>
        </div>
        {{/inscriptos}}

        <div class="text-center pb-6 mt-4">
            <a href="/docente/notas-finales" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline text-sm transition-colors">← Volver a Mesas de Examen</a>
        </div>
    </div>
    {{> _layout_footer}}
</body>
</html>
