<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Aula Virtual - {{materia_nombre}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] min-h-screen p-6">
    <div class="max-w-6xl mx-auto space-y-6">
        
        <div class="bg-gradient-to-r from-[#190019] to-[#854f6c] p-6 rounded-lg shadow-lg border border-purple-900/30 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">{{materia_nombre}}</h1>
                <p class="text-purple-200">Código: {{materia_codigo}} | Tu Estado: <span class="font-bold">{{estado_alumno}}</span></p>
            </div>
            <a href="/estudiante/aula-virtual" class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded transition">Volver</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div class="space-y-6">
                <div class="bg-white/10 p-6 rounded-lg shadow-lg border border-purple-900/30">
                    <h2 class="text-xl font-bold text-[#ccd0fc] mb-4 flex items-center gap-2">
                        <span>📝</span> Mi Calificación
                    </h2>
                    {{#sinNota}}
                    <div class="bg-blue-900/40 border border-blue-500/50 p-4 rounded text-blue-200 text-center">
                        Tu docente aún no te ha cargado una nota en esta materia.
                    </div>
                    {{/sinNota}}
                    {{^sinNota}}
                    <div class="text-center p-6 bg-green-900/40 border border-green-500/50 rounded-lg">
                        <span class="block text-4xl font-bold text-green-400">{{nota_valor}}</span>
                        <span class="block text-green-200 text-sm mt-2">Nota Oficial</span>
                    </div>
                    {{/sinNota}}
                </div>

                <div class="bg-white/10 p-6 rounded-lg shadow-lg border border-purple-900/30">
                    <h2 class="text-xl font-bold text-[#ccd0fc] mb-4 flex items-center gap-2">
                        <span>👨‍🏫</span> Profesores y Aulas
                    </h2>
                    {{#docentes_aulas}}
                    <div class="mb-3 pb-3 border-b border-purple-900/30 last:border-0 last:pb-0 last:mb-0">
                        <p class="text-white font-semibold">{{docente_nombre}} {{docente_apellido}}</p>
                        <p class="text-sm text-purple-300">Aula: <span class="text-yellow-400 font-mono">{{aula}}</span></p>
                    </div>
                    {{/docentes_aulas}}
                    {{^docentes_aulas}}
                    <p class="text-purple-300 text-sm">No hay docentes ni aulas asignadas todavía.</p>
                    {{/docentes_aulas}}
                </div>
            </div>

            <div class="md:col-span-2 space-y-4">
                <h2 class="text-2xl font-bold text-white mb-4">Novedades y Anuncios</h2>
                
                {{#anuncios}}
                <div class="bg-white/10 p-6 rounded-lg shadow-lg border border-purple-900/30 relative">
                    {{#esExamen}}
                    <span class="absolute top-4 right-4 bg-red-500/20 text-red-300 border border-red-500/50 text-xs px-2 py-1 rounded font-bold">PARCIAL / EXAMEN</span>
                    {{/esExamen}}
                    {{^esExamen}}
                    <span class="absolute top-4 right-4 bg-blue-500/20 text-blue-300 border border-blue-500/50 text-xs px-2 py-1 rounded font-bold">{{tipo}}</span>
                    {{/esExamen}}
                    
                    <h3 class="text-xl font-bold text-[#ccd0fc] mb-1 pr-24">{{titulo}}</h3>
                    <p class="text-xs text-purple-300 mb-4">Publicado por {{autor}} - {{fecha}}</p>
                    <p class="text-gray-200 whitespace-pre-wrap">{{contenido}}</p>
                    
                    {{#esExamen}}
                    <div class="mt-4 pt-4 border-t border-purple-900/30">
                        <p class="text-red-300 font-semibold mb-2">📅 Fecha estipulada: {{fecha_examen}}</p>
                    </div>
                    {{/esExamen}}
                </div>
                {{/anuncios}}

                {{^anuncios}}
                <div class="bg-white/5 border border-purple-900/20 p-8 rounded-lg text-center text-purple-300">
                    Aún no hay anuncios publicados en esta materia.
                </div>
                {{/anuncios}}
            </div>
        </div>
    </div>
</body>
</html>