<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Aula Virtual - {{materia_nombre}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="max-w-6xl mx-auto space-y-6 p-4 md:p-8">
        
        <div class="bg-[#1a3a5c] dark:bg-[#112133] p-6 rounded-lg shadow-sm border border-[#2471a3] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">{{materia_nombre}}</h1>
                <p class="text-[#eaf2ff]">Código: {{materia_codigo}} | Tu Estado: <span class="font-bold">{{estado_alumno}}</span></p>
            </div>
            <a href="/estudiante/aula-virtual" class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded transition-colors border border-white/20 text-sm">Volver</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div class="space-y-6">
                <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white mb-4 flex items-center gap-2">
                        <span>📝 </span> Mi Calificación
                    </h2>
                    {{#sinNota}}
                    <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 p-4 rounded text-blue-800 dark:text-blue-200 text-center text-sm">
                        Tu docente aún no te ha cargado una nota en esta materia.
                    </div>
                    {{/sinNota}}
                    {{^sinNota}}
                    <div class="text-center p-6 bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-lg">
                        <span class="block text-4xl font-bold text-green-600 dark:text-green-400">{{nota_valor}}</span>
                        <span class="block text-green-700 dark:text-green-300 text-sm mt-2">Nota Oficial</span>
                    </div>
                    {{/sinNota}}
                </div>

                <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white mb-4 flex items-center gap-2">
                        <span>👨‍🏫</span> Profesores y Aulas
                    </h2>
                    {{#docentes_aulas}}
                    <div class="mb-3 pb-3 border-b border-gray-200 dark:border-gray-600 last:border-0 last:pb-0 last:mb-0">
                        <p class="text-gray-900 dark:text-white font-semibold">{{docente_nombre}} {{docente_apellido}}</p>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Aula: <span class="text-[#2471a3] dark:text-blue-400 font-mono font-medium">{{aula}}</span></p>
                    </div>
                    {{/docentes_aulas}}
                    {{^docentes_aulas}}
                    <p class="text-gray-500 dark:text-gray-400 text-sm italic">No hay docentes ni aulas asignadas todavía.</p>
                    {{/docentes_aulas}}
                </div>
            </div>

            <div class="md:col-span-2 space-y-4">
                <h2 class="text-2xl font-bold text-[#1a3a5c] dark:text-white mb-4 border-b border-[#2471a3] dark:border-blue-400 pb-2">Novedades y Anuncios</h2>
                
                {{#anuncios}}
                <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 relative">
                    {{#esExamen}}
                    <span class="absolute top-4 right-4 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 text-xs px-2 py-1 rounded font-bold">PARCIAL / EXAMEN</span>
                    {{/esExamen}}
                    {{^esExamen}}
                    <span class="absolute top-4 right-4 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 text-xs px-2 py-1 rounded font-bold">{{tipo}}</span>
                    {{/esExamen}}
                    
                    <h3 class="text-xl font-bold text-[#1a3a5c] dark:text-white mb-1 pr-24">{{titulo}}</h3>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Publicado por {{autor}} - {{fecha}}</p>
                    <p class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap">{{contenido}}</p>
                    
                    {{#esExamen}}
                    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                        <p class="text-red-600 dark:text-red-400 font-semibold mb-2 text-sm flex items-center gap-1"><span>📅</span> Fecha estipulada: {{fecha_examen}}</p>
                    </div>
                    {{/esExamen}}
                </div>
                {{/anuncios}}

                {{^anuncios}}
                <div class="bg-gray-50 dark:bg-[#1a2b3c] border border-gray-200 dark:border-gray-600 p-8 rounded-lg text-center text-gray-500 dark:text-gray-400 italic">
                    Aún no hay anuncios publicados en esta materia.
                </div>
                {{/anuncios}}
            </div>
        </div>
    </div>
    {{> _layout_footer}}
</body>
</html>
