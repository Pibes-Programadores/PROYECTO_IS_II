<!-- Script para evitar FOUC de Modo Oscuro -->
<script>
    if (localStorage.getItem('sgu-theme') === 'dark' || (!('sgu-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
    } else {
        document.documentElement.classList.remove('dark');
    }
</script>

