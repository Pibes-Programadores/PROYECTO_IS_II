<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Materias — SiGU</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <main class="max-w-6xl mx-auto p-4 md:p-8">

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-[#1a3a5c] dark:text-white mb-1">Mis Materias</h1>
            {{#nombrePlan}}
            <p class="text-gray-600 dark:text-gray-400 text-sm">{{nombrePlan}}</p>
            {{/nombrePlan}}
        </div>

        {{#successMessage}}
        <div class="mb-6 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg text-sm">
            ✓ {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg text-sm">
            ✗ {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="bg-white dark:bg-[#2a3a4d] border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-[#1a3a5c] text-white dark:bg-[#112133]">
                        <th class="text-left px-5 py-4 font-semibold uppercase tracking-wider text-xs w-24">
                            Código
                        </th>
                        <th class="text-left px-5 py-4 font-semibold uppercase tracking-wider text-xs">
                            Asignatura
                        </th>
                        <th class="text-center px-5 py-4 font-semibold uppercase tracking-wider text-xs w-36">
                            Estado
                        </th>
                        <th class="text-center px-5 py-4 font-semibold uppercase tracking-wider text-xs w-24">
                            Nota
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    {{#materias}}
                    {{#anioHeader}}
                    <tr class="bg-gray-100 dark:bg-[#1e2a3a] border-t border-gray-200 dark:border-gray-700">
                        <td colspan="4" class="px-5 py-2">
                            <span class="text-gray-600 dark:text-gray-400 text-xs font-semibold uppercase tracking-widest">
                                {{anioHeader}}
                            </span>
                        </td>
                    </tr>
                    {{/anioHeader}}
                    <tr class="hover:bg-gray-50 dark:hover:bg-[#1f3044] transition-colors">
                        <td class="px-5 py-4 font-mono text-gray-500 dark:text-gray-400 text-xs">{{codigo}}</td>
                        <td class="px-5 py-4 text-[#2471a3] dark:text-[#eaf2ff] font-medium">{{nombre}}</td>
                        <td class="px-5 py-4 text-center">
                            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold border {{estadoClase}}">
                                {{estado}}
                            </span>
                        </td>
                        <td class="px-5 py-4 text-center font-mono text-sm text-gray-700 dark:text-gray-300">{{nota}}</td>
                    </tr>
                    {{/materias}}
                    {{^materias}}
                    <tr>
                        <td colspan="4" class="py-16 text-center">
                            <div class="text-gray-400 dark:text-gray-500 text-4xl mb-3">📋</div>
                            <p class="text-gray-600 dark:text-gray-400 text-sm">
                                No hay materias registradas en tu plan de estudio.
                            </p>
                            <p class="text-gray-500 dark:text-gray-500 text-xs mt-1">
                                Contactá a la Secretaría Académica.
                            </p>
                        </td>
                    </tr>
                    {{/materias}}
                </tbody>
            </table>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700 flex justify-center">
            <a href="/dashboard" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline transition-colors text-sm flex items-center gap-2">
                ← Volver al panel principal
            </a>
        </div>

    </main>
    {{> _layout_footer}}
</body>
</html>
