<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Materias — SiGU</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: linear-gradient(135deg, #190019, #dfb6b2); min-height: 100vh; }
        .text-brand { color: #ccd0fc; }
        .row-hover:hover { background-color: rgba(255, 255, 255, 0.04); }
    </style>
</head>
<body class="min-h-screen font-sans">

    <nav class="bg-black/30 backdrop-blur-sm border-b border-white/10 px-6 py-4">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <span class="text-brand font-bold text-xl tracking-wide">SiGU</span>
            <div class="flex items-center gap-4">
                <a href="/dashboard"
                   class="text-white/60 hover:text-brand text-sm transition-colors">
                    ← Volver al Dashboard
                </a>
                <a href="/logout"
                   class="text-white/60 hover:text-red-300 text-sm transition-colors">
                    Cerrar sesión
                </a>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 py-10">

        <div class="mb-8">
            <h1 class="text-brand text-3xl font-bold mb-1">Mis Materias</h1>
            {{#nombrePlan}}
            <p class="text-white/50 text-sm">{{nombrePlan}}</p>
            {{/nombrePlan}}
        </div>

        {{#successMessage}}
        <div class="mb-6 bg-green-500/20 border border-green-500/40 text-green-200 px-4 py-3 rounded-lg text-sm">
            ✓ {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="mb-6 bg-red-500/20 border border-red-500/40 text-red-200 px-4 py-3 rounded-lg text-sm">
            ✗ {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden backdrop-blur-sm">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-white/10 bg-black/20">
                        <th class="text-left px-5 py-4 text-white/50 font-semibold uppercase tracking-wider text-xs w-24">
                            Código
                        </th>
                        <th class="text-left px-5 py-4 text-white/50 font-semibold uppercase tracking-wider text-xs">
                            Asignatura
                        </th>
                        <th class="text-center px-5 py-4 text-white/50 font-semibold uppercase tracking-wider text-xs w-36">
                            Estado
                        </th>
                        <th class="text-center px-5 py-4 text-white/50 font-semibold uppercase tracking-wider text-xs w-24">
                            Nota
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {{#materias}}
                    {{#anioHeader}}
                    <tr class="bg-black/25 border-t border-white/10">
                        <td colspan="4" class="px-5 py-2">
                            <span class="text-white/35 text-xs font-semibold uppercase tracking-widest">
                                {{anioHeader}}
                            </span>
                        </td>
                    </tr>
                    {{/anioHeader}}
                    <tr class="row-hover transition-colors">
                        <td class="px-5 py-4 font-mono text-white/40 text-xs">{{codigo}}</td>
                        <td class="px-5 py-4 text-brand font-medium">{{nombre}}</td>
                        <td class="px-5 py-4 text-center">
                            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold border {{estadoClase}}">
                                {{estado}}
                            </span>
                        </td>
                        <td class="px-5 py-4 text-center font-mono text-sm text-white/70">{{nota}}</td>
                    </tr>
                    {{/materias}}
                    {{^materias}}
                    <tr>
                        <td colspan="4" class="py-16 text-center">
                            <div class="text-white/20 text-4xl mb-3">📋</div>
                            <p class="text-white/40 text-sm">
                                No hay materias registradas en tu plan de estudio.
                            </p>
                            <p class="text-white/25 text-xs mt-1">
                                Contactá a la Secretaría Académica.
                            </p>
                        </td>
                    </tr>
                    {{/materias}}
                </tbody>
            </table>
        </div>

    </main>
</body>
</html>