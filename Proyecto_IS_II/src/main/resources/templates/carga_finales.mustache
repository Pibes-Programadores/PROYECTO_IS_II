<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mesas de Examen — Docente</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] min-h-screen p-6 flex flex-col items-center">
    <div class="w-full max-w-4xl space-y-6">
        <div class="bg-[#190019]/60 border border-indigo-700/40 rounded-lg p-6">
            <h1 class="text-3xl font-bold text-indigo-400">📋 Carga de Actas de Finales</h1>
            <p class="text-[#ccd0fc] text-sm mt-1">Seleccioná una mesa para ver los inscriptos y cargar calificaciones</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">{{successMessage}}</div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">{{errorMessage}}</div>
        {{/errorMessage}}

        <div class="bg-[#190019]/60 border border-indigo-700/20 rounded-lg overflow-hidden">
            <table class="w-full text-left text-white">
                <thead>
                    <tr class="border-b border-indigo-700/30 text-[#ccd0fc]">
                        <th class="py-3 px-4 text-sm font-semibold">Materia</th>
                        <th class="py-3 px-4 text-sm font-semibold">Fecha del Final</th>
                        <th class="py-3 px-4 text-sm font-semibold text-center">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-indigo-700/20">
                    {{#mesas}}
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="py-4 px-4">
                            <p class="font-semibold">{{nombreMateria}}</p>
                            <p class="text-[#ccd0fc] text-xs font-mono">Código {{materiaCodigo}}</p>
                        </td>
                        <td class="py-4 px-4 text-gray-300">{{fecha}}</td>
                        <td class="py-4 px-4 text-center">
                            <a href="/docente/notas-finales/{{id}}"
                               class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-1.5 px-4 rounded transition-colors">
                                Ver inscriptos →
                            </a>
                        </td>
                    </tr>
                    {{/mesas}}
                    {{^mesas}}
                    <tr>
                        <td colspan="3" class="text-center text-[#ccd0fc]/50 py-10 text-sm italic">
                            No hay mesas de examen asignadas a tus materias.
                        </td>
                    </tr>
                    {{/mesas}}
                </tbody>
            </table>
        </div>

        <div class="text-center pb-6">
            <a href="/docente/materias" class="text-purple-300 hover:underline text-sm">← Volver a Mis Materias</a>
        </div>
    </div>
</body>
</html>