<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] flex items-center justify-center min-h-screen p-4">
    <div class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] p-8 rounded-lg shadow-lg w-full max-w-2xl">
        <h1 class="text-3xl font-bold text-center text-green-400 mb-6">Alta de Estudiante</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/student/new" method="post" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="name" class="block text-[#ccd0fc] text-sm font-medium mb-1">Nombre:</label>
                    <input type="text" id="name" name="name" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500">
                </div>
                <div>
                    <label for="lastname" class="block text-[#ccd0fc] text-sm font-medium mb-1">Apellido:</label>
                    <input type="text" id="lastname" name="lastname" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="dni" class="block text-[#ccd0fc] text-sm font-medium mb-1">DNI:</label>
                    <input type="text" id="dni" name="dni" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500">
                </div>
                <div>
                    <label for="email" class="block text-[#ccd0fc] text-sm font-medium mb-1">Email Institucional:</label>
                    <input type="email" id="email" name="email" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500">
                </div>

            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="legajo" class="block text-[#ccd0fc] text-sm font-medium mb-1">Legajo:</label>
                    <input type="text" id="legajo" name="legajo" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500">
                </div>
                <div>
                    <label for="tipo_estudiante" class="block text-[#ccd0fc] text-sm font-medium mb-1">Tipo de Estudiante:</label>
                        <select id="tipo_estudiante" name="tipo_estudiante" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                            <option value="REGULAR">Regular</option>
                            <option value="VOCACIONAL">Vocacional</option>
                            <option value="INTERCAMBIO">Intercambio</option>
                        </select>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4">
                <div>
                    <label for="plan_estudio_id" class="block text-[#ccd0fc] text-sm font-medium mb-1">Plan de Estudios:</label>
                    <select id="plan_estudio_id" name="plan_estudio_id" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                        <option value="" disabled selected>-- Seleccione un Plan --</option>
                        {{#planes}}
                        <option value="{{id}}">{{descripcion}}</option>
                        {{/planes}}
                    </select>
                </div>
            </div>
            <button type="submit" class="w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 mt-4">
                Registrar Estudiante
            </button>
            <div class="text-center mt-4">
                <a href="/dashboard" class="text-green-400 hover:underline text-sm">Volver al Dashboard</a>
            </div>
        </form>
    </div>
</body>
</html>
