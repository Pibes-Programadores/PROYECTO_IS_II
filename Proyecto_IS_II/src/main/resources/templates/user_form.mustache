<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Crear una cuenta</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-2xl bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <h1 class="text-3xl font-bold text-center text-[#1a3a5c] dark:text-white mb-6">Crear una cuenta</h1>

            {{#successMessage}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{successMessage}}</span>
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <form action="/user/new" method="post" class="space-y-4">
                <div>
                    <label for="name" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nombre de Usuario:</label>
                    <input type="text" id="name" name="name" required
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                </div>

                <div>
                    <label for="password" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Contraseña:</label>
                    <input type="password" id="password" name="password" required
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                </div>

                <div>
                    <label for="role" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Tipo de Usuario (Rol):</label>
                    <select id="role" name="role" required
                            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                        <option value="ESTUDIANTE">Estudiante</option>
                        <option value="DOCENTE">Docente</option>
                        <option value="SECRETARIA">Secretaría Académica</option>
                        <option value="ADMIN">Administrador del Sistema</option>
                    </select>
                </div>
                <button type="submit"
                       class="w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors duration-300 font-medium focus:outline-none focus:ring-2 focus:ring-[#2471a3] focus:ring-offset-2">
                    Registrar Usuario
                </button>

                <div class="text-center mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <a href="/login" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline transition-colors text-sm">← Volver al login</a>
                </div>
            </form>
        </div>
    </div>
    {{> _layout_footer}}
</body>
</html>
