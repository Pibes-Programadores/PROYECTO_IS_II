<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SiGU - Configuración</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="max-w-6xl mx-auto p-4 md:p-8">

        <!-- Header -->
        <div class="mb-6 flex items-center justify-between flex-wrap gap-3">
            <div>
                <h1 class="text-3xl font-bold text-[#1a3a5c] dark:text-white">⚙️ Configuración</h1>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Gestión de docentes, estudiantes y materias</p>
            </div>
            <a href="/dashboard" class="flex items-center gap-2 text-[#2471a3] dark:text-[#eaf2ff] hover:underline transition-colors duration-200 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Volver al panel
            </a>
        </div>

        <!-- Mensajes flash -->
        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <!-- Tabs -->
        <div class="flex gap-2 mb-0 border-b border-gray-300 dark:border-gray-700" id="tabs">
            <button onclick="switchTab('docentes')"    id="tab-docentes"
                class="tab-btn px-5 py-2.5 rounded-t-lg text-sm font-semibold transition-all duration-200 focus:outline-none border-t border-l border-r border-transparent">
                👨‍🏫 Docentes
            </button>
            <button onclick="switchTab('estudiantes')" id="tab-estudiantes"
                class="tab-btn px-5 py-2.5 rounded-t-lg text-sm font-semibold transition-all duration-200 focus:outline-none border-t border-l border-r border-transparent">
                🎓 Estudiantes
            </button>
            <button onclick="switchTab('materias')"    id="tab-materias"
                class="tab-btn px-5 py-2.5 rounded-t-lg text-sm font-semibold transition-all duration-200 focus:outline-none border-t border-l border-r border-transparent">
                📚 Materias
            </button>
        </div>

        <div class="bg-white dark:bg-[#2a3a4d] rounded-b-xl rounded-tr-xl p-6 shadow-md border border-gray-200 dark:border-gray-700 border-t-0">

            <!-- ====== TAB: DOCENTES ====== -->
            <div id="panel-docentes" class="tab-panel">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h2 class="text-[#1a3a5c] dark:text-white font-semibold text-lg">Docentes registrados</h2>
                    <input type="text"
                           placeholder="Filtrar por nombre, legajo o email..."
                           oninput="filterTable('tabla-docentes', this.value)"
                           class="px-3 py-1.5 rounded-md bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#2471a3] w-full sm:w-72">
                </div>

                <div class="overflow-x-auto">
                    <table id="tabla-docentes" class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 uppercase text-xs tracking-wider">
                                <th class="text-left py-2 pr-4">Nombre</th>
                                <th class="text-left py-2 pr-4">Legajo</th>
                                <th class="text-left py-2 pr-4">Email</th>
                                <th class="text-left py-2 pr-4">Especialidad</th>
                                <th class="text-left py-2">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                            {{#docentes}}
                            <tr class="hover:bg-gray-50 dark:hover:bg-[#1f3044] transition-colors">
                                <td class="py-2.5 pr-4 text-gray-900 dark:text-white font-medium">{{nombre}}</td>
                                <td class="py-2.5 pr-4 text-gray-600 dark:text-gray-400 font-mono text-xs">{{legajo}}</td>
                                <td class="py-2.5 pr-4 text-gray-600 dark:text-gray-400">{{email}}</td>
                                <td class="py-2.5 pr-4 text-gray-500 dark:text-gray-500 text-xs">{{especialidad}}</td>
                                <td class="py-2.5">
                                    <div class="flex items-center gap-2">
                                        <a href="/docente/edit/{{id}}"
                                           class="px-3 py-1 rounded text-xs font-semibold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 hover:bg-blue-200 dark:hover:bg-blue-800/50 transition-colors">
                                            Editar
                                        </a>
                                        <form action="/docente/delete/{{id}}" method="post" style="display:inline;">
                                            <button type="submit"
                                                onclick="return confirm('¿Eliminar a {{nombre}}?\nSe eliminarán también sus materias asignadas, notas y anuncios.')"
                                                class="px-3 py-1 rounded text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 hover:bg-red-200 dark:hover:bg-red-800/50 transition-colors">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/docentes}}
                        </tbody>
                    </table>
                </div>

                {{^docentes}}
                <div class="text-center py-16 text-gray-500 dark:text-gray-400">
                    <div class="text-5xl mb-3">👨‍🏫</div>
                    <p>No hay docentes registrados en el sistema.</p>
                </div>
                {{/docentes}}
            </div>

            <!-- ====== TAB: ESTUDIANTES ====== -->
            <div id="panel-estudiantes" class="tab-panel hidden">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h2 class="text-[#1a3a5c] dark:text-white font-semibold text-lg">Estudiantes registrados</h2>
                    <input type="text"
                           placeholder="Filtrar por nombre, legajo o carrera..."
                           oninput="filterTable('tabla-estudiantes', this.value)"
                           class="px-3 py-1.5 rounded-md bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#2471a3] w-full sm:w-72">
                </div>

                <div class="overflow-x-auto">
                    <table id="tabla-estudiantes" class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 uppercase text-xs tracking-wider">
                                <th class="text-left py-2 pr-4">Nombre</th>
                                <th class="text-left py-2 pr-4">Legajo</th>
                                <th class="text-left py-2 pr-4">Tipo</th>
                                <th class="text-left py-2 pr-4">Carrera</th>
                                <th class="text-left py-2">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                            {{#estudiantes}}
                            <tr class="hover:bg-gray-50 dark:hover:bg-[#1f3044] transition-colors">
                                <td class="py-2.5 pr-4 text-gray-900 dark:text-white font-medium">{{nombre}}</td>
                                <td class="py-2.5 pr-4 text-gray-600 dark:text-gray-400 font-mono text-xs">{{legajo}}</td>
                                <td class="py-2.5 pr-4">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">
                                        {{tipo}}
                                    </span>
                                </td>
                                <td class="py-2.5 pr-4 text-gray-500 dark:text-gray-500 text-xs">{{carrera}}</td>
                                <td class="py-2.5">
                                    <div class="flex items-center gap-2">
                                        <a href="/estudiante/edit/{{id}}"
                                           class="px-3 py-1 rounded text-xs font-semibold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 hover:bg-blue-200 dark:hover:bg-blue-800/50 transition-colors">
                                            Editar
                                        </a>
                                        <form action="/estudiante/delete/{{id}}" method="post" style="display:inline;">
                                            <button type="submit"
                                                onclick="return confirm('¿Eliminar a {{nombre}}?\nSe eliminarán también su historial académico, inscripciones y notas.')"
                                                class="px-3 py-1 rounded text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 hover:bg-red-200 dark:hover:bg-red-800/50 transition-colors">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/estudiantes}}
                        </tbody>
                    </table>
                </div>

                {{^estudiantes}}
                <div class="text-center py-16 text-gray-500 dark:text-gray-400">
                    <div class="text-5xl mb-3">🎓</div>
                    <p>No hay estudiantes registrados en el sistema.</p>
                </div>
                {{/estudiantes}}
            </div>

            <!-- ====== TAB: MATERIAS ====== -->
            <div id="panel-materias" class="tab-panel hidden">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h2 class="text-[#1a3a5c] dark:text-white font-semibold text-lg">Materias registradas</h2>
                    <input type="text"
                           placeholder="Filtrar por nombre, código o carrera..."
                           oninput="filterTable('tabla-materias', this.value)"
                           class="px-3 py-1.5 rounded-md bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#2471a3] w-full sm:w-72">
                </div>

                <div class="overflow-x-auto">
                    <table id="tabla-materias" class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 uppercase text-xs tracking-wider">
                                <th class="text-left py-2 pr-4">Código</th>
                                <th class="text-left py-2 pr-4">Nombre</th>
                                <th class="text-left py-2 pr-4">Carrera</th>
                                <th class="text-left py-2 pr-4">Año</th>
                                <th class="text-left py-2 pr-4">Carga hs.</th>
                                <th class="text-left py-2">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                            {{#materias}}
                            <tr class="hover:bg-gray-50 dark:hover:bg-[#1f3044] transition-colors">
                                <td class="py-2.5 pr-4 text-gray-500 dark:text-gray-500 font-mono text-xs">{{codigo}}</td>
                                <td class="py-2.5 pr-4 text-gray-900 dark:text-white font-medium">{{nombre}}</td>
                                <td class="py-2.5 pr-4 text-gray-600 dark:text-gray-400 text-xs">{{carrera}}</td>
                                <td class="py-2.5 pr-4 text-gray-700 dark:text-gray-300">{{anio}}°</td>
                                <td class="py-2.5 pr-4 text-gray-600 dark:text-gray-400 text-xs">{{carga}}</td>
                                <td class="py-2.5">
                                    <div class="flex items-center gap-2">
                                        <a href="/materia/edit/{{codigo}}"
                                           class="px-3 py-1 rounded text-xs font-semibold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 hover:bg-blue-200 dark:hover:bg-blue-800/50 transition-colors">
                                            Editar
                                        </a>
                                        <form action="/materia/delete/{{codigo}}" method="post" style="display:inline;">
                                            <button type="submit"
                                                onclick="return confirm('¿Eliminar la materia {{nombre}}?\nSe eliminarán correlatividades, períodos, inscripciones y notas.')"
                                                class="px-3 py-1 rounded text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 hover:bg-red-200 dark:hover:bg-red-800/50 transition-colors">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/materias}}
                        </tbody>
                    </table>
                </div>

                {{^materias}}
                <div class="text-center py-16 text-gray-500 dark:text-gray-400">
                    <div class="text-5xl mb-3">📚</div>
                    <p>No hay materias registradas en el sistema.</p>
                </div>
                {{/materias}}
            </div>

        </div>
    </div>

    <script>
        const TABS = ['docentes', 'estudiantes', 'materias'];

        function switchTab(tab) {
            TABS.forEach(t => {
                const panel = document.getElementById('panel-' + t);
                const btn   = document.getElementById('tab-' + t);
                const active = (t === tab);
                panel.classList.toggle('hidden', !active);
                if (active) {
                    btn.classList.add('bg-white', 'dark:bg-[#2a3a4d]', 'text-[#1a3a5c]', 'dark:text-white', 'border-gray-200', 'dark:border-gray-700', 'border-b-transparent', 'dark:border-b-[#2a3a4d]');
                    btn.classList.remove('bg-gray-100', 'dark:bg-[#1e2a3a]', 'text-gray-600', 'dark:text-gray-400', 'border-transparent', 'hover:bg-gray-200', 'dark:hover:bg-[#1a2b3c]');
                } else {
                    btn.classList.remove('bg-white', 'dark:bg-[#2a3a4d]', 'text-[#1a3a5c]', 'dark:text-white', 'border-gray-200', 'dark:border-gray-700', 'border-b-transparent', 'dark:border-b-[#2a3a4d]');
                    btn.classList.add('bg-gray-100', 'dark:bg-[#1e2a3a]', 'text-gray-600', 'dark:text-gray-400', 'border-transparent', 'hover:bg-gray-200', 'dark:hover:bg-[#1a2b3c]');
                }
            });
            history.replaceState(null, '', '#' + tab);
        }

        const hashTab = (window.location.hash || '#docentes').substring(1);
        switchTab(TABS.includes(hashTab) ? hashTab : 'docentes');

        function filterTable(tableId, query) {
            const q   = query.toLowerCase();
            const tbl = document.getElementById(tableId);
            if (!tbl) return;
            tbl.querySelectorAll('tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
    {{> _layout_footer}}
</body>
</html>
