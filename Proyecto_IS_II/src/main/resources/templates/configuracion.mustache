<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SiGU - Configuración</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full min-h-screen bg-gradient-to-b from-[#190019] to-[#dfb6b2] p-4 md:p-8">

    <div class="max-w-6xl mx-auto">

        <!-- Header -->
        <div class="mb-6 flex items-center justify-between flex-wrap gap-3">
            <div>
                <h1 class="text-3xl font-bold text-[#ccd0fc]">⚙ Configuración</h1>
                <p class="text-white/50 text-sm mt-1">Gestión de docentes, estudiantes y materias</p>
            </div>
            <a href="/dashboard" class="flex items-center gap-2 text-[#ccd0fc] hover:text-white transition-colors duration-200 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Volver al panel
            </a>
        </div>

        <!-- Mensajes flash -->
        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <!-- Tabs -->
        <div class="flex gap-2 mb-0" id="tabs">
            <button onclick="switchTab('docentes')"    id="tab-docentes"
                class="tab-btn px-5 py-2.5 rounded-t-lg text-sm font-semibold transition-all duration-200 focus:outline-none">
                👨‍🏫 Docentes
            </button>
            <button onclick="switchTab('estudiantes')" id="tab-estudiantes"
                class="tab-btn px-5 py-2.5 rounded-t-lg text-sm font-semibold transition-all duration-200 focus:outline-none">
                🎓 Estudiantes
            </button>
            <button onclick="switchTab('materias')"    id="tab-materias"
                class="tab-btn px-5 py-2.5 rounded-t-lg text-sm font-semibold transition-all duration-200 focus:outline-none">
                📚 Materias
            </button>
        </div>

        <div class="bg-gradient-to-b from-[#190019] to-[#2d0a2d] rounded-b-xl rounded-tr-xl p-6 shadow-2xl shadow-black/50">

            <!-- ====== TAB: DOCENTES ====== -->
            <div id="panel-docentes" class="tab-panel">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h2 class="text-[#ccd0fc] font-semibold text-lg">Docentes registrados</h2>
                    <input type="text"
                           placeholder="Filtrar por nombre, legajo o email..."
                           oninput="filterTable('tabla-docentes', this.value)"
                           class="px-3 py-1.5 rounded-md bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#ccd0fc]/50 w-full sm:w-72">
                </div>

                <div class="overflow-x-auto">
                    <table id="tabla-docentes" class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-white/10 text-white/50 uppercase text-xs tracking-wider">
                                <th class="text-left py-2 pr-4">Nombre</th>
                                <th class="text-left py-2 pr-4">Legajo</th>
                                <th class="text-left py-2 pr-4">Email</th>
                                <th class="text-left py-2 pr-4">Especialidad</th>
                                <th class="text-left py-2">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#docentes}}
                            <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                                <td class="py-2.5 pr-4 text-white font-medium">{{nombre}}</td>
                                <td class="py-2.5 pr-4 text-white/70 font-mono text-xs">{{legajo}}</td>
                                <td class="py-2.5 pr-4 text-white/70">{{email}}</td>
                                <td class="py-2.5 pr-4 text-white/60 text-xs">{{especialidad}}</td>
                                <td class="py-2.5">
                                    <div class="flex items-center gap-2">
                                        <a href="/docente/edit/{{id}}"
                                           class="px-3 py-1 rounded text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30 hover:bg-blue-500/40 transition-colors">
                                            Editar
                                        </a>
                                        <form action="/docente/delete/{{id}}" method="post" style="display:inline;">
                                            <button type="submit"
                                                onclick="return confirm('¿Eliminar a {{nombre}}?\nSe eliminarán también sus materias asignadas, notas y anuncios.')"
                                                class="px-3 py-1 rounded text-xs font-semibold bg-red-500/20 text-red-300 border border-red-500/30 hover:bg-red-500/40 transition-colors">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/docentes}}
                        </tbody>
                    </table>
                </div>

                {{^docentes}}
                <div class="text-center py-16 text-white/40">
                    <div class="text-5xl mb-3">👨‍🏫</div>
                    <p>No hay docentes registrados en el sistema.</p>
                </div>
                {{/docentes}}
            </div>

            <!-- ====== TAB: ESTUDIANTES ====== -->
            <div id="panel-estudiantes" class="tab-panel hidden">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h2 class="text-[#ccd0fc] font-semibold text-lg">Estudiantes registrados</h2>
                    <input type="text"
                           placeholder="Filtrar por nombre, legajo o carrera..."
                           oninput="filterTable('tabla-estudiantes', this.value)"
                           class="px-3 py-1.5 rounded-md bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#ccd0fc]/50 w-full sm:w-72">
                </div>

                <div class="overflow-x-auto">
                    <table id="tabla-estudiantes" class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-white/10 text-white/50 uppercase text-xs tracking-wider">
                                <th class="text-left py-2 pr-4">Nombre</th>
                                <th class="text-left py-2 pr-4">Legajo</th>
                                <th class="text-left py-2 pr-4">Tipo</th>
                                <th class="text-left py-2 pr-4">Carrera</th>
                                <th class="text-left py-2">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#estudiantes}}
                            <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                                <td class="py-2.5 pr-4 text-white font-medium">{{nombre}}</td>
                                <td class="py-2.5 pr-4 text-white/70 font-mono text-xs">{{legajo}}</td>
                                <td class="py-2.5 pr-4">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-500/20 text-green-300 border border-green-500/30">
                                        {{tipo}}
                                    </span>
                                </td>
                                <td class="py-2.5 pr-4 text-white/60 text-xs">{{carrera}}</td>
                                <td class="py-2.5">
                                    <div class="flex items-center gap-2">
                                        <a href="/estudiante/edit/{{id}}"
                                           class="px-3 py-1 rounded text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30 hover:bg-blue-500/40 transition-colors">
                                            Editar
                                        </a>
                                        <form action="/estudiante/delete/{{id}}" method="post" style="display:inline;">
                                            <button type="submit"
                                                onclick="return confirm('¿Eliminar a {{nombre}}?\nSe eliminarán también su historial académico, inscripciones y notas.')"
                                                class="px-3 py-1 rounded text-xs font-semibold bg-red-500/20 text-red-300 border border-red-500/30 hover:bg-red-500/40 transition-colors">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/estudiantes}}
                        </tbody>
                    </table>
                </div>

                {{^estudiantes}}
                <div class="text-center py-16 text-white/40">
                    <div class="text-5xl mb-3">🎓</div>
                    <p>No hay estudiantes registrados en el sistema.</p>
                </div>
                {{/estudiantes}}
            </div>

            <!-- ====== TAB: MATERIAS ====== -->
            <div id="panel-materias" class="tab-panel hidden">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h2 class="text-[#ccd0fc] font-semibold text-lg">Materias registradas</h2>
                    <input type="text"
                           placeholder="Filtrar por nombre, código o carrera..."
                           oninput="filterTable('tabla-materias', this.value)"
                           class="px-3 py-1.5 rounded-md bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#ccd0fc]/50 w-full sm:w-72">
                </div>

                <div class="overflow-x-auto">
                    <table id="tabla-materias" class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-white/10 text-white/50 uppercase text-xs tracking-wider">
                                <th class="text-left py-2 pr-4">Código</th>
                                <th class="text-left py-2 pr-4">Nombre</th>
                                <th class="text-left py-2 pr-4">Carrera</th>
                                <th class="text-left py-2 pr-4">Año</th>
                                <th class="text-left py-2 pr-4">Carga hs.</th>
                                <th class="text-left py-2">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#materias}}
                            <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                                <td class="py-2.5 pr-4 text-white/50 font-mono text-xs">{{codigo}}</td>
                                <td class="py-2.5 pr-4 text-white font-medium">{{nombre}}</td>
                                <td class="py-2.5 pr-4 text-white/60 text-xs">{{carrera}}</td>
                                <td class="py-2.5 pr-4 text-white/70">{{anio}}°</td>
                                <td class="py-2.5 pr-4 text-white/60 text-xs">{{carga}}</td>
                                <td class="py-2.5">
                                    <div class="flex items-center gap-2">
                                        <a href="/materia/edit/{{codigo}}"
                                           class="px-3 py-1 rounded text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30 hover:bg-blue-500/40 transition-colors">
                                            Editar
                                        </a>
                                        <form action="/materia/delete/{{codigo}}" method="post" style="display:inline;">
                                            <button type="submit"
                                                onclick="return confirm('¿Eliminar la materia {{nombre}}?\nSe eliminarán correlatividades, períodos, inscripciones y notas.')"
                                                class="px-3 py-1 rounded text-xs font-semibold bg-red-500/20 text-red-300 border border-red-500/30 hover:bg-red-500/40 transition-colors">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/materias}}
                        </tbody>
                    </table>
                </div>

                {{^materias}}
                <div class="text-center py-16 text-white/40">
                    <div class="text-5xl mb-3">📚</div>
                    <p>No hay materias registradas en el sistema.</p>
                </div>
                {{/materias}}
            </div>

        </div>
    </div>

    <script>
        const TABS = ['docentes', 'estudiantes', 'materias'];

        function switchTab(tab) {
            TABS.forEach(t => {
                const panel = document.getElementById('panel-' + t);
                const btn   = document.getElementById('tab-' + t);
                const active = (t === tab);
                panel.classList.toggle('hidden', !active);
                if (active) {
                    btn.classList.add('bg-gradient-to-b', 'from-[#190019]', 'to-[#2d0a2d]', 'text-[#ccd0fc]');
                    btn.classList.remove('text-white/50', 'hover:text-white/80');
                } else {
                    btn.classList.remove('bg-gradient-to-b', 'from-[#190019]', 'to-[#2d0a2d]', 'text-[#ccd0fc]');
                    btn.classList.add('text-white/50', 'hover:text-white/80');
                }
            });
            history.replaceState(null, '', '#' + tab);
        }

        const hashTab = (window.location.hash || '#docentes').substring(1);
        switchTab(TABS.includes(hashTab) ? hashTab : 'docentes');

        function filterTable(tableId, query) {
            const q   = query.toLowerCase();
            const tbl = document.getElementById(tableId);
            if (!tbl) return;
            tbl.querySelectorAll('tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
</body>
</html>