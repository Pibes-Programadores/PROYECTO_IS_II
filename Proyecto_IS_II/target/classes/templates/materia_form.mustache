<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Nueva Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] flex items-center justify-center min-h-screen p-4">
    <div class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] p-8 rounded-lg shadow-lg w-full max-w-2xl">
        <h1 class="text-3xl font-bold text-center text-green-400 mb-6">Alta de Materia y Configuración Académica</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/materia/new" method="post" class="space-y-4">
            
            <h2 class="text-xl font-semibold text-[#ccd0fc] border-b border-green-500 pb-1">1. Datos de la Asignatura</h2>
            
            <div class="mt-4">
                <label for="plan_estudio_id" class="block text-[#ccd0fc] text-sm font-medium mb-1">Carrera y Plan de Estudio:</label>
                <select id="plan_estudio_id" name="plan_estudio_id" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                    <option value="">-- Seleccione una Carrera / Plan --</option>
                    {{#planes}}
                    <option value="{{id}}">{{descripcion}}</option>
                    {{/planes}}
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4 mt-4">
                <div>
                    <label for="codigo" class="block text-[#ccd0fc] text-sm font-medium mb-1">Código de Materia:</label>
                    <input type="text" id="codigo" name="codigo" required inputmode="numeric" pattern="\d+" title="Ingrese únicamente números positivos (ej: 3398)" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 text-gray-900" placeholder="Ej: 3398">
                </div>
                <div>
                    <label for="nombre" class="block text-[#ccd0fc] text-sm font-medium mb-1">Nombre de la Materia:</label>
                    <input type="text" id="nombre" name="nombre" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 text-gray-900" placeholder="Ej: Ingeniería de Software I">
                </div>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mt-4">
                <div>
                    <label for="anio_cursada" class="block text-[#ccd0fc] text-sm font-medium mb-1">Año de Cursada (1° a 5°):</label>
                    <input type="number" id="anio_cursada" name="anio_cursada" min="1" max="6" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 text-gray-900">
                </div>
                <div>
                    <label for="carga_horaria_total" class="block text-[#ccd0fc] text-sm font-medium mb-1">Carga Horaria Total:</label>
                    <input type="number" id="carga_horaria_total" name="carga_horaria_total" min="1" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 text-gray-900" placeholder="Ej: 96">
                </div>
            </div>

            <h2 class="text-xl font-semibold text-[#ccd0fc] border-b border-green-500 pb-1 pt-4">2. Periodo de Dictado</h2>
            <div>
                <label for="tipo_cuatrimestre" class="block text-[#ccd0fc] text-sm font-medium mb-1">Régimen de Cursado:</label>
                <select id="tipo_cuatrimestre" name="tipo_cuatrimestre" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                    <option value="PRIMER_CUATRIMESTRE">Primer Cuatrimestre</option>
                    <option value="SEGUNDO_CUATRIMESTRE">Segundo Cuatrimestre</option>
                    <option value="ANUAL">Anual</option>
                    <option value="VERANO">Curso de Verano</option>
                </select>
            </div>

            <h2 class="text-xl font-semibold text-[#ccd0fc] border-b border-green-500 pb-1 pt-4 flex justify-between items-center">
                3. Régimen de Correlatividades
                <button type="button" onclick="agregarCorrelatividad()" class="text-sm bg-green-700 hover:bg-green-600 text-white py-1 px-3 rounded-md transition">
                    + Seleccionar otra correlatividad
                </button>
            </h2>
            
            <div id="correlatividades_container" class="space-y-4 mt-4">
                <div class="corr-row bg-[#190019]/40 p-4 rounded-md border border-green-500/30 grid grid-cols-2 gap-4">
                    <div class="col-span-2">
                        <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Asignatura Vinculada (Opcional):</label>
                        <select name="materia_correlativa_codigo" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                            <option value="none">-- Ninguna --</option>
                            {{#materiasExistentes}}
                            <option value="{{codigo}}">[{{codigo}}] - {{nombre}}</option>
                            {{/materiasExistentes}}
                        </select>
                    </div>
                    
                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Tipo de Requisito:</label>
                        <select name="tipo_requisito" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                            <option value="CURSAR">Requisito para CURSAR</option>
                            <option value="RENDIR">Requisito para RENDIR (Final)</option>
                        </select>
                    </div>
                    
                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Condición Exigida:</label>
                        <select name="condicion" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                            <option value="APROBADA">Tenerla Aprobada</option>
                            <option value="REGULAR">Tenerla Regular</option>
                        </select>
                    </div>

                    <div class="col-span-2">
                        <label class="block text-[#ccd0fc] text-sm font-medium mb-1">Sentido de Relación:</label>
                        <select name="sentido_correlatividad" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-green-500 bg-white text-gray-900">
                            <option value="REQUIERE">Esta nueva materia REQUIERE de la seleccionada</option>
                            <option value="ES_REQUISITO">Esta nueva materia ES REQUISITO para la seleccionada</option>
                        </select>
                    </div>
                </div>
            </div>

            <script>
                function agregarCorrelatividad() {
                    const container = document.getElementById('correlatividades_container');
                    const rows = container.getElementsByClassName('corr-row');
                    
                    // Calculamos cuántas materias reales hay (restando la opción "-- Ninguna --")
                    const selectElement = rows[0].querySelector('select[name="materia_correlativa_codigo"]');
                    const maxMaterias = selectElement.options.length - 1;

                    if (rows.length >= maxMaterias) {
                        alert("Has alcanzado el límite máximo. No puedes cargar más correlatividades que la cantidad de materias existentes.");
                        return;
                    }

                    // Clonamos el bloque y lo agregamos
                    const newRow = rows[0].cloneNode(true);
                    newRow.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
                    container.appendChild(newRow);
                }
            </script>

            <button type="submit" class="w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition duration-300 mt-6">
                Dar de Alta Materia
            </button>
            
            <div class="text-center mt-4">
                <a href="/dashboard" class="text-green-400 hover:underline text-sm">Volver al Dashboard</a>
            </div>
        </form>
    </div>
</body>
</html>