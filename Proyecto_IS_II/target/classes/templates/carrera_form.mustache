<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Cargar Carrera y Plan de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-2xl bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 mx-auto">
        <h1 class="text-3xl font-bold text-center text-[#1a3a5c] dark:text-white mb-6">Alta de Carrera y Plan de Estudio</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/carrera/new" method="post" class="space-y-4">
            
            <h2 class="text-xl font-semibold text-[#1a3a5c] dark:text-white border-b border-[#2471a3] dark:border-blue-400 pb-1">1. Información de la Carrera</h2>
            <div>
                <label for="nombre" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nombre Completo de la Carrera:</label>
                <input type="text" id="nombre" name="nombre" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="duracion_anios" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Duración (en años):</label>
                    <input type="number" id="duracion_anios" name="duracion_anios" min="1" max="10" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label for="titulo_otorgado" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Título Otorgado:</label>
                    <input type="text" id="titulo_otorgado" name="titulo_otorgado" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
            </div>

            <h2 class="text-xl font-semibold text-[#1a3a5c] dark:text-white border-b border-[#2471a3] dark:border-blue-400 pb-1 pt-4">2. Plan de Estudio Inicial</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="anio_resolucion" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Año de Resolución:</label>
                    <input type="number" id="anio_resolucion" name="anio_resolucion" min="1900" max="2100" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label for="estado" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Estado Inicial:</label>
                    <select id="estado" name="estado" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        <option value="VIGENTE">Vigente</option>
                        <option value="OBSOLETO">Obsoleto</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-[#2471a3] mt-6">
                Guardar Carrera y Vincular Plan
            </button>
            
            <div class="text-center mt-4">
                <a href="/dashboard" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline text-sm transition-colors">← Volver al panel principal</a>
            </div>
        </form>
    </div>
    {{> _layout_footer}}
</body>
</html>
