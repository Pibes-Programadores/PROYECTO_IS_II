<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Iniciar sesión</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a] flex flex-col min-h-screen">
    <!-- Script para evitar FOUC -->
    <script>
        if (localStorage.getItem('sgu-theme') === 'dark' || (!('sgu-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <nav class="bg-[#1a3a5c] dark:bg-[#112133] text-white shadow-md w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center gap-2">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0v7"></path>
                        </svg>
                        <span class="font-bold text-xl tracking-wide">SiGU</span>
                    </div>
                </div>
                
                <div class="flex items-center gap-4">
                    <!-- Toggle Modo Oscuro -->
                    <button id="theme-toggle" class="p-2 rounded-md hover:bg-[#2471a3] dark:hover:bg-[#1f3044] transition-colors focus:outline-none focus:ring-2 focus:ring-[#2471a3]">
                        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
                        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-[#1a3a5c] dark:text-white">Iniciar Sesión</h1>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Ingrese sus credenciales para acceder</p>
            </div>

            {{#successMessage}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{successMessage}}</span>
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <form action="/login" method="post" class="space-y-6">
                <div>
                    <label for="username" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">DNI / Nombre de Usuario:</label>
                    <input type="text" id="username" name="username" required
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label for="password" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Contraseña:</label>
                    <input type="password" id="password" name="password" required
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <button type="submit"
                        class="w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] focus:outline-none focus:ring-2 focus:ring-[#2471a3] focus:ring-offset-2 transition-colors">
                    Ingresar
                </button>
            </form>
            
            <div class="mt-8 text-center text-sm">
                <p class="text-gray-600 dark:text-gray-400">¿Olvidó su clave?</p>
                <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">Si tiene registrada una dirección de correo electrónico en el Sistema de Información, comuníquese con administración.</p>
            </div>
        </div>
    </div>

    <!-- Script de Modo Oscuro -->
    <script>
        var themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
        var themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
        var themeToggleBtn = document.getElementById('theme-toggle');

        if (document.documentElement.classList.contains('dark')) {
            themeToggleLightIcon.classList.remove('hidden');
        } else {
            themeToggleDarkIcon.classList.remove('hidden');
        }

        themeToggleBtn.addEventListener('click', function() {
            themeToggleDarkIcon.classList.toggle('hidden');
            themeToggleLightIcon.classList.toggle('hidden');

            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('sgu-theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('sgu-theme', 'dark');
            }
        });
    </script>
</body>
</html>
