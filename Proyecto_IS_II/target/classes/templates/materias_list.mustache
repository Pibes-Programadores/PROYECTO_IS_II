<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Plan de Estudios - Grilla Académica</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-5xl bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 mx-auto">
        <h1 class="text-3xl font-bold text-center text-[#1a3a5c] dark:text-white mb-6">Grilla de Plan de Estudios</h1>

        <form action="/carrera/materias" method="get" class="bg-gray-50 dark:bg-[#1a2b3c] p-4 rounded-md border border-gray-200 dark:border-gray-600 flex flex-col sm:flex-row gap-4 items-end mb-6">
            <div class="flex-1 w-full">
                <label for="plan_id" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Seleccione la Carrera / Plan:</label>
                <select id="plan_id" name="plan_id" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    <option value="">-- Seleccionar Carrera --</option>
                    {{#planes}}
                    <option value="{{id}}">{{descripcion}}</option>
                    {{/planes}}
                </select>
            </div>
            <button type="submit" class="w-full sm:w-auto bg-[#2471a3] text-white px-6 py-2 rounded-md hover:bg-[#1a5276] font-medium transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-[#2471a3]">
                Buscar Plan
            </button>
        </form>

        {{#mostrarTabla}}
        <div class="overflow-x-auto rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
            <table class="w-full text-sm text-left text-gray-700 dark:text-gray-300 bg-white dark:bg-[#2a3a4d]">
                <thead class="text-xs uppercase bg-[#1a3a5c] text-white dark:bg-[#112133]">
                    <tr>
                        <th scope="col" class="px-6 py-4 w-1/4">Año y Periodo</th>
                        <th scope="col" class="px-6 py-4 w-1/6 text-center">Código</th>
                        <th scope="col" class="px-6 py-4 w-1/3">Asignatura</th>
                        <th scope="col" class="px-6 py-4 text-center">Correlativas p/ Cursar<br><span class="text-[10px] font-normal opacity-80">(Aprobadas)</span></th>
                        <th scope="col" class="px-6 py-4 text-center">Correlativas p/ Cursar<br><span class="text-[10px] font-normal opacity-80">(Regulares)</span></th>
                        <th scope="col" class="px-6 py-4 text-center">Para Rendir<br><span class="text-[10px] font-normal opacity-80">(Aprobadas)</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    {{#materias}}
                    <tr class="hover:bg-gray-50 dark:hover:bg-[#1f3044] transition-colors border-b border-gray-200 dark:border-gray-700 last:border-0">
                        <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">{{periodo_vista}}</td>
                        <td class="px-6 py-4 text-center font-mono font-bold text-gray-600 dark:text-gray-400">{{codigo}}</td>
                        <td class="px-6 py-4 font-semibold text-[#2471a3] dark:text-[#eaf2ff]">[{{codigo}}] - {{nombre}}</td>
                        <td class="px-6 py-4 text-center font-mono text-gray-700 dark:text-gray-300">{{correlativas_aprobadas}}</td>
                        <td class="px-6 py-4 text-center font-mono text-gray-700 dark:text-gray-300">{{correlativas_regulares}}</td>
                        <td class="px-6 py-4 text-center font-mono text-gray-700 dark:text-gray-300">{{correlativas_rendir}}</td>
                    </tr>
                    {{/materias}}
                </tbody>
            </table>
        </div>
        {{/mostrarTabla}}

        {{#sinMaterias}}
        <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 text-blue-800 dark:text-blue-200 p-4 rounded-md text-center">
            ⚠️ Aún no hay asignaturas registradas para este plan de estudio específico.
        </div>
        {{/sinMaterias}}

        <div class="text-center mt-6">
            <a href="/dashboard" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline text-sm transition-colors">← Volver al panel principal</a>
        </div>
    </div>
    {{> _layout_footer}}
</body>
</html>
