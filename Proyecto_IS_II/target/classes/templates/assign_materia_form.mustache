<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Asignar Materia a Docente</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] flex items-center justify-center min-h-screen p-4">
<div class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] p-8 rounded-lg shadow-lg w-full max-w-2xl">
    <h1 class="text-3xl font-bold text-center text-[#ccd0fc] mb-6">Asignar Materia a Docente</h1>

    {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
    {{/successMessage}}

    {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
    {{/errorMessage}}

    <!-- Mensaje de error de validación del lado del cliente -->
    <div id="clientError" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
        <span id="clientErrorText"></span>
    </div>

    <form id="assignForm" action="/teacher/assign-materia" method="post" class="space-y-6" novalidate>

        <!-- PASO 1: Plan de Estudio -->
        <div>
            <label for="plan_id" class="block text-[#ccd0fc] text-sm font-medium mb-2">
                Plan de Estudio:
            </label>
            <select id="plan_id" name="plan_id" required
                    class="w-full px-4 py-3 border rounded-md bg-white text-black">
                <option value="">— Seleccione un plan —</option>
                {{#planes}}
                    <option value="{{id}}" data-carrera="{{carrera_id}}">{{descripcion}}</option>
                {{/planes}}
            </select>
        </div>

        <!-- PASO 2: Materia (se carga dinámicamente al elegir el plan) -->
        <div>
            <label for="materia_id" class="block text-[#ccd0fc] text-sm font-medium mb-2">
                Materia:
            </label>
            <select id="materia_id" name="materia_id" required
                    class="w-full px-4 py-3 border rounded-md bg-white text-black"
                    disabled>
                <option value="">— Primero seleccione un plan —</option>
            </select>
        </div>

        <!-- PASO 3: Buscador inteligente de docentes -->
        <div class="relative">
            <label for="docenteSearch" class="block text-[#ccd0fc] text-sm font-medium mb-2">
                Docente:
            </label>
            <input
                    type="text"
                    id="docenteSearch"
                    placeholder="Buscar por nombre, apellido o legajo…"
                    autocomplete="off"
                    disabled
                    class="w-full px-4 py-3 border rounded-md bg-white text-black disabled:opacity-50"
            />
            <!-- Campo oculto que almacena el ID real del docente seleccionado -->
            <input type="hidden" id="teacher_id" name="teacher_id" value="" />

            <!-- Lista flotante de sugerencias -->
            <ul id="suggestList"
                class="hidden absolute z-10 w-full bg-white border border-gray-300 rounded-md shadow-lg mt-1 max-h-60 overflow-y-auto">
            </ul>
        </div>

        <button type="submit"
                class="w-full bg-yellow-500 text-white py-3 px-4 rounded-md hover:bg-yellow-700 transition duration-300">
            Asignar materia
        </button>

        <div class="mt-8 pt-6 border-t border-[#ccd0fc]/20 flex justify-center">
            <a href="/dashboard" class="flex items-center gap-2 text-[#ccd0fc] hover:text-white transition-colors duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span> Volver al panel principal</span>
            </a>
        </div>
    </form>
</div>

<script>
    (() => {
        // ── Referencias a elementos del DOM ──────────────────────────────────
        const planSelect     = document.getElementById('plan_id');
        const materiaSelect  = document.getElementById('materia_id');
        const docenteSearch  = document.getElementById('docenteSearch');
        const teacherIdInput = document.getElementById('teacher_id');
        const suggestList    = document.getElementById('suggestList');
        const assignForm     = document.getElementById('assignForm');
        const clientError    = document.getElementById('clientError');
        const clientErrorText = document.getElementById('clientErrorText');

        let debounceTimer = null;

        // ── Helpers ──────────────────────────────────────────────────────────
        function showError(msg) {
            clientErrorText.textContent = msg;
            clientError.classList.remove('hidden');
        }
        function hideError() {
            clientError.classList.add('hidden');
            clientErrorText.textContent = '';
        }
        function closeSuggestions() {
            suggestList.innerHTML = '';
            suggestList.classList.add('hidden');
        }
        function resetDocente() {
            teacherIdInput.value = '';
            docenteSearch.value  = '';
        }
        function resetMateria() {
            materiaSelect.innerHTML = '<option value="">— Primero seleccione un plan —</option>';
            materiaSelect.disabled  = true;
        }

        // ── PASO 1 → carga de materias por plan ──────────────────────────────
        planSelect.addEventListener('change', async () => {
            hideError();
            resetMateria();
            resetDocente();
            closeSuggestions();
            docenteSearch.disabled = true;

            const planId = planSelect.value;
            if (!planId) return;

            materiaSelect.innerHTML = '<option value="">Cargando materias…</option>';

            try {
                const resp = await fetch(`/api/materias-por-plan?plan_id=${planId}`);
                if (!resp.ok) throw new Error('Error del servidor');
                const materias = await resp.json();

                materiaSelect.innerHTML = '<option value="">— Seleccione una materia —</option>';
                if (materias.length === 0) {
                    materiaSelect.innerHTML = '<option value="">Sin materias en este plan</option>';
                    return;
                }
                materias.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value       = m.id;
                    opt.textContent = m.nombre;
                    materiaSelect.appendChild(opt);
                });
                materiaSelect.disabled = false;

                // Habilitamos el buscador de docentes ahora que hay una carrera elegida
                docenteSearch.disabled = false;
            } catch (e) {
                materiaSelect.innerHTML = '<option value="">Error al cargar materias</option>';
                showError('No se pudieron cargar las materias. Intente de nuevo.');
            }
        });

        // ── PASO 3 → autocomplete de docentes ───────────────────────────────
        docenteSearch.addEventListener('input', () => {
            // Si el usuario edita el texto luego de haber elegido, invalidamos la selección
            teacherIdInput.value = '';

            clearTimeout(debounceTimer);
            const query = docenteSearch.value.trim();
            if (query.length < 2) {
                closeSuggestions();
                return;
            }

            debounceTimer = setTimeout(async () => {
                const selectedOption = planSelect.selectedOptions[0];
                if (!selectedOption) return;
                const carreraId = selectedOption.dataset.carrera;
                if (!carreraId) return;

                try {
                    const resp = await fetch(
                            `/api/docentes-search?carrera_id=${carreraId}&query=${encodeURIComponent(query)}`
                    );
                    if (!resp.ok) throw new Error('Error del servidor');
                    const docentes = await resp.json();

                    closeSuggestions();
                    if (docentes.length === 0) {
                        const li = document.createElement('li');
                        li.textContent = 'Sin resultados para esta búsqueda.';
                        li.className   = 'px-4 py-2 text-gray-500 text-sm italic';
                        suggestList.appendChild(li);
                        suggestList.classList.remove('hidden');
                        return;
                    }

                    docentes.forEach(d => {
                        const li = document.createElement('li');
                        li.textContent = d.label;
                        li.className   =
                                'px-4 py-2 cursor-pointer hover:bg-indigo-100 text-black text-sm';
                        li.addEventListener('mousedown', (e) => {
                            // mousedown en lugar de click para que no se dispare el blur antes
                            e.preventDefault();
                            docenteSearch.value  = d.label;
                            teacherIdInput.value = d.id;
                            closeSuggestions();
                            hideError();
                        });
                        suggestList.appendChild(li);
                    });
                    suggestList.classList.remove('hidden');
                } catch (err) {
                    closeSuggestions();
                }
            }, 300); // debounce de 300 ms
        });

        // Cerramos la lista al perder el foco sobre el input
        docenteSearch.addEventListener('blur', () => {
            setTimeout(closeSuggestions, 150);
        });

        // ── Validación antes de enviar el formulario ─────────────────────────
        assignForm.addEventListener('submit', (e) => {
            hideError();

            const planId    = planSelect.value;
            const materiaId = materiaSelect.value;
            const teacherId = teacherIdInput.value;
            const searchTxt = docenteSearch.value.trim();

            if (!planId) {
                e.preventDefault();
                showError('Debe seleccionar un Plan de Estudio.');
                return;
            }
            if (!materiaId) {
                e.preventDefault();
                showError('Debe seleccionar una Materia.');
                return;
            }
            // Si escribió algo en el buscador pero no eligió un docente válido
            if (searchTxt && !teacherId) {
                e.preventDefault();
                showError('Debe seleccionar un docente válido de la lista de sugerencias.');
                docenteSearch.focus();
                return;
            }
            if (!teacherId) {
                e.preventDefault();
                showError('Debe buscar y seleccionar un Docente.');
                docenteSearch.focus();
                return;
            }
        });
    })();
</script>
</body>
</html>