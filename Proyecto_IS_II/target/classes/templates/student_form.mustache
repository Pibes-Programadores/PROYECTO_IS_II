<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Cargar Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-2xl bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 mx-auto">
        <h1 class="text-3xl font-bold text-center text-[#1a3a5c] dark:text-white mb-6">Alta de Estudiante</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/student/new" method="post" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="name" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nombre:</label>
                    <input type="text" id="name" name="name" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label for="lastname" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Apellido:</label>
                    <input type="text" id="lastname" name="lastname" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="dni" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">DNI:</label>
                    <input type="text" id="dni" name="dni" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label for="email" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Email Institucional:</label>
                    <input type="email" id="email" name="email" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="legajo" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Legajo:</label>
                    <input type="text" id="legajo" name="legajo" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label for="tipo_estudiante" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Tipo de Estudiante:</label>
                        <select id="tipo_estudiante" name="tipo_estudiante" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                            <option value="REGULAR">Regular</option>
                            <option value="VOCACIONAL">Vocacional</option>
                            <option value="INTERCAMBIO">Intercambio</option>
                        </select>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4">
                <div>
                    <label for="plan_estudio_id" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Plan de Estudios:</label>
                    <select id="plan_estudio_id" name="plan_estudio_id" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        <option value="" disabled selected>-- Seleccione un Plan --</option>
                        {{#planes}}
                        <option value="{{id}}">{{descripcion}}</option>
                        {{/planes}}
                    </select>
                </div>
            </div>
            
            <button type="submit" class="w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-[#2471a3] mt-6">
                Registrar Estudiante
            </button>
            <div class="text-center mt-4">
                <a href="/dashboard" class="text-[#2471a3] dark:text-[#eaf2ff] hover:underline text-sm transition-colors">← Volver al panel principal</a>
            </div>
        </form>
    </div>
    {{> _layout_footer}}
</body>
</html>
