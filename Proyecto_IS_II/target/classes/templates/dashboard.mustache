<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SiGU - Bienvenido</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-5xl mx-auto flex flex-col gap-6">
        
        <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
            <h1 class="text-3xl font-bold text-[#1a3a5c] dark:text-white mb-2">Panel de Control</h1>
            
            {{#username}}
            <p class="text-lg text-gray-600 dark:text-gray-300">¡Bienvenido, <span class="font-semibold text-[#2471a3] dark:text-blue-400">{{username}}</span>!</p>
            {{/username}}
            {{^username}}
            <p class="text-lg text-gray-600 dark:text-gray-300">¡Bienvenido!</p>
            {{/username}}
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            
            <!-- Perfil -->
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-[#2471a3] dark:text-blue-300">
                        👤
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Tu Perfil</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Gestiona la información de tu cuenta.</p>
                <a href="/perfil" class="text-center block w-full bg-gray-100 dark:bg-[#1a2b3c] text-[#2471a3] dark:text-white py-2 px-4 rounded-md hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors border border-gray-300 dark:border-gray-600 font-medium">Ver Perfil</a>
            </div>

            <!-- Grilla Plan -->
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center text-indigo-600 dark:text-indigo-300">
                        📋
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Plan de Estudios</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Visualizar la grilla de materias y correlatividades.</p>
                <a href="/carrera/materias" class="text-center block w-full bg-gray-100 dark:bg-[#1a2b3c] text-[#2471a3] dark:text-white py-2 px-4 rounded-md hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors border border-gray-300 dark:border-gray-600 font-medium">Ver Grilla</a>
            </div>

            {{#isAdmin}}
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/50 flex items-center justify-center text-orange-600 dark:text-orange-300">
                        👨‍🏫
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Cargar un docente</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Gestionar el alta de un docente de la universidad.</p>
                <a href="/teacher/new" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Cargar</a>
            </div>

            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-yellow-100 dark:bg-yellow-900/50 flex items-center justify-center text-yellow-600 dark:text-yellow-300">
                        🔗
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Asignar materia</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Relacionar una materia con un docente del sistema.</p>
                <a href="/teacher/assign-materia" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Asignar</a>
            </div>

            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-300">
                        👨‍🎓
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Cargar estudiante</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Gestionar el alta de un alumno de la universidad.</p>
                <a href="/student/new" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Cargar</a>
            </div>

            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-300">
                        👩‍💼
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Cargar Secretario/a</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Gestionar el alta de personal administrativo.</p>
                <a href="/secretariaAcademica/new" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Cargar</a>
            </div>
            
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center text-purple-600 dark:text-purple-300">
                        🛤️
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Cargar Carrera y Plan</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Alta de nuevas carreras y sus planes de estudio.</p>
                <a href="/carrera/new" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Cargar</a>
            </div>
            
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/50 flex items-center justify-center text-emerald-600 dark:text-emerald-300">
                        📚
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Cargar Materia</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Configurar nuevas asignaturas y correlatividades.</p>
                <a href="/materia/new" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Cargar</a>
            </div>
            
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-900/50 flex items-center justify-center text-rose-600 dark:text-rose-300">
                        ⚙️
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Configuración</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Buscar, editar y eliminar datos del sistema.</p>
                <a href="/configuracion" class="text-center block w-full bg-rose-600 text-white py-2 px-4 rounded-md hover:bg-rose-700 transition-colors font-medium">Administrar</a>
            </div>
            {{/isAdmin}}

            {{#isDocente}}
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center text-purple-600 dark:text-purple-300">
                        📘
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Mis Materias</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Gestioná tus materias: publicá anuncios, cargá notas y asigná aulas.</p>
                <a href="/docente/materias" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Ver Materias</a>
            </div>
            {{/isDocente}}

            {{#isEstudiante}}
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-yellow-100 dark:bg-yellow-900/50 flex items-center justify-center text-yellow-600 dark:text-yellow-300">
                        💻
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Aula Virtual</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Mirá los anuncios de tus materias y confirmá tu asistencia a parciales.</p>
                <a href="/estudiante/aula-virtual" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Entrar</a>
            </div>

            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-300">
                        📝
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Inscripción a Cursar</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Inscribite en las materias habilitadas para cursar según tu plan de estudios.</p>
                <a href="/estudiante/inscripcion/cursada" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Inscribir Materias</a>
            </div>
            
            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-300">
                        ✏️
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Inscripción a Exámenes</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Anotate para rendir exámenes finales en las materias que tenés regulares o libres.</p>
                <a href="/estudiante/inscripcion/examen" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Inscribir Exámenes</a>
            </div>

            <div class="bg-white dark:bg-[#2a3a4d] p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-teal-100 dark:bg-teal-900/50 flex items-center justify-center text-teal-600 dark:text-teal-300">
                        📖
                    </div>
                    <h2 class="text-xl font-bold text-[#1a3a5c] dark:text-white">Mis Materias</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-4 flex-1 text-sm">Consultá tu historial académico: estado y notas por materia.</p>
                <a href="/estudiante/materias" class="text-center block w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors font-medium">Ver Historial</a>
            </div>
            {{/isEstudiante}}
        </div>
        
    </div>
    {{> _layout_footer}}
</body>
</html>
