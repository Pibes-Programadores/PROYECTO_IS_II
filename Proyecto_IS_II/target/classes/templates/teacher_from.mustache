<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SiGU - Cargar Docente</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
</head>
<body class="bg-[#f4f6f9] dark:bg-[#1e2a3a]">
    {{> _layout_header}}
    <div class="w-full max-w-2xl bg-white dark:bg-[#2a3a4d] p-8 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 mx-auto">
        <h1 class="text-3xl font-bold text-center text-[#1a3a5c] dark:text-white mb-6">Cargar Nuevo Docente</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/teacher/new" method="post" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nombre:</label>
                    <input type="text" name="teacher_name" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Apellido:</label>
                    <input type="text" name="teacher_lastname" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                </div>
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">DNI:</label>
                <input type="text" name="teacher_dni" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">CUIL:</label>
                <input type="text" name="teacher_cuil" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Dirección:</label>
                <input type="text" name="teacher_address" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Teléfono:</label>
                <input type="text" name="teacher_phone" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>

            <hr class="border-gray-300 dark:border-gray-600 my-4">

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Legajo Docente:</label>
                <input type="text" name="legajo_docente" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Carrera de designación:</label>
                <select name="carrera_id" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    <option value="" disabled selected>Seleccione una carrera</option>
                    {{#carreras}}
                        <option value="{{id}}">{{nombre}}</option>
                    {{/carreras}}
                </select>
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Email:</label>
                <input type="email" name="teacher_email" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Especialidad (Título):</label>
                <input type="text" name="especialidad" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-[#2471a3] bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            </div>

            <button type="submit" class="w-full bg-[#2471a3] text-white py-2 px-4 rounded-md hover:bg-[#1a5276] transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-[#2471a3] mt-6">
                Registrar Docente
            </button>

            <div class="mt-8 pt-6 border-t border-gray-300 dark:border-gray-600 flex justify-center">
                 <a href="/dashboard" class="flex items-center gap-2 text-[#2471a3] dark:text-[#eaf2ff] hover:underline transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                   </svg>
                    <span> Volver al panel principal</span>
                </a>
            </div>
        </form>
    </div>
    {{> _layout_footer}}
</body>
</html>
