<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Secretario/a</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] flex items-center justify-center min-h-screen p-4">
    <div class="w-full bg-gradient-to-b from-[#190019] to-[#dfb6b2] p-8 rounded-lg shadow-lg w-full max-w-2xl">
        <h1 class="text-3xl font-bold text-center text-blue-400 mb-6">Alta de Secretaría</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/secretariaAcademica/new" method="post" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="name" class="block text-[#ccd0fc] text-sm font-medium mb-1">Nombre:</label>
                    <input type="text" id="name" name="name" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label for="lastname" class="block text-[#ccd0fc] text-sm font-medium mb-1">Apellido:</label>
                    <input type="text" id="lastname" name="lastname" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="dni" class="block text-[#ccd0fc] text-sm font-medium mb-1">DNI:</label>
                    <input type="text" id="dni" name="dni" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label for="email" class="block text-[#ccd0fc] text-sm font-medium mb-1">Email (Usuario):</label>
                    <input type="email" id="email" name="email" required class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="oficina" class="block text-[#ccd0fc] text-sm font-medium mb-1">Oficina:</label>
                    <input type="text" id="oficina" name="oficina" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500" placeholder="Ej: Bedelía">
                </div>
                <div>
                    <label for="interno" class="block text-[#ccd0fc] text-sm font-medium mb-1">Interno (Tel):</label>
                    <input type="text" id="interno" name="interno" class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500" placeholder="Ej: 104">
                </div>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 mt-4">
                Registrar Secretario/a
            </button>
            <div class="text-center mt-4">
                <a href="/dashboard" class="text-blue-400 hover:underline text-sm">← Volver al panel principal</a>
            </div>
        </form>
    </div>
</body>
</html>
